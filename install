#!/bin/bash
# Install the packages and link this repository's configuration into place.
# Warning: replaces existing configuration for every app listed below.
set -e -o pipefail

current_dir=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

clone_if_missing() {
    local url=$1 destination=$2
    if [[ ! -e "$destination/.git" ]]; then
        git clone -- "$url" "$destination"
    fi
}

create_symlinks() {
    local source_directory="$1"
    local target_directory="$2"
    local full_source_directory="${current_dir}/$source_directory"

    # Ensure the target directory exists
    mkdir -p "$target_directory"

    # Loop through each file in the source directory
    for file in "$full_source_directory"/*; do
        if [ -f "$file" ]; then
            ln -sf "$file" "$target_directory"
        fi
    done
}

# link SOURCE TARGET: replace TARGET with a symlink to SOURCE in this repo.
link() {
    if [[ ! -e "$current_dir/$1" ]]; then
        printf 'Missing link source: %s\n' "$current_dir/$1" >&2
        return 1
    fi
    mkdir -p "$(dirname "$2")"
    rm -rf "$2"
    ln -s "${current_dir}/$1" "$2"
}

packages=("wget" "ranger" "tmux" "curl" "unzip" "rustup" "base-devel" "git" "hyprland" "xdg-desktop-portal-hyprland" "nautilus" "flatpak" "grim" "wl-clipboard" "slurp" "swaync" "blueman" "btop" "zsh" "starship" "neovim" "zathura" "lsd" "fastfetch" "bat" "ttf-ibm-plex" "ttf-lilex-nerd" "ttf-jetbrains-mono-nerd" "qemu-system-x86" "qemu-system-x86-firmware" "libvirt" "virt-manager" "qemu-hw-display-virtio-gpu-gl" "qemu-hw-display-virtio-gpu" "qemu-hw-display-virtio-gpu-pci" "qemu-hw-display-virtio-gpu-pci-gl" "dnsmasq" "qemu-img" "docker" "docker-compose" "hyprpaper" "hyprlock" "ripgrep" "qt5-wayland" "qt6-wayland" "lib32-glibc" "lib32-gcc-libs" "easyeffects" "network-manager-applet" "feh" "xorg-server" "lxappearance" "zathura-pdf-poppler" "gnome-tweaks" "gnome-themes-extra" "plymouth" "obsidian" "hyprpolkitagent" "qemu-full" "gdb" "vlc" "jq" "man-pages" "hypridle" "vulkan-radeon" "eza" "rsync" "firefox" "rofi" "less" "git-delta" "discord" "zoxide" "pavucontrol" "go" "nodejs" "hyprsunset" "ghostty" "tlp" "qt6ct" "swayosd" "hyprpicker" "brightnessctl" "cliphist" "fzf" "playerctl" "libnotify" "python-numpy" "python-pillow" "quickshell" "chafa")
# Filter out already installed packages
to_install=()
for pkg in "${packages[@]}"; do
    if ! pacman -Qq $pkg &>/dev/null; then
        to_install+=("$pkg")
    fi
done
if (( ${#to_install[@]} > 0 )); then
    sudo pacman -S --noconfirm "${to_install[@]}"
else
    echo "Dependencies already installed."
fi

mkdir -p "$HOME/.cargo"
rm -rf "$HOME/.cargo/config.toml"
ln -s "${current_dir}/cargo/config.toml" "$HOME/.cargo/config.toml"

# Install paru
if ! command -v paru >/dev/null; then
    (
        build_dir=$(mktemp -d)
        trap 'rm -rf -- "$build_dir"' EXIT
        git clone https://aur.archlinux.org/paru-bin.git "$build_dir"
        cd "$build_dir"
        makepkg -si --noconfirm
    )
else
    echo "Paru already installed."
fi

# Install AUR packages
# waybar-git includes Hyprland Lua dispatch support needed by Hyprland >= 0.54 workspace clicks.
aur_packages=("waybar-git" "rate-mirrors-bin" "visual-studio-code-bin")
aur_to_install=()

for pkg in "${aur_packages[@]}"; do
    if ! pacman -Qq $pkg &>/dev/null; then
        aur_to_install+=("$pkg")
    fi
done
if (( ${#aur_to_install[@]} > 0 )); then
    paru -S --noconfirm --skipreview "${aur_to_install[@]}"
else
    echo "AUR dependencies already installed."
fi

# Nocturne: the palette and its generated colour files. Several apps import
# from ~/.config/nocturne, so this link comes first.
link nocturne ~/.config/nocturne

# Install AstroNvim
rm -rf ~/.config/nvim ~/.local/share/nvim ~/.local/state/nvim ~/.cache/nvim
ln -s "${current_dir}/nvim" ~/.config/nvim

# tmux, with the plugin manager
link tmux.conf ~/.tmux.conf
clone_if_missing https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm

# Terminal
link ghostty ~/.config/ghostty

# Install herdr config, keeping runtime state outside the repository
mkdir -p "$HOME/.config/herdr"
ln -sfnT "${current_dir}/herdr/config.toml" "$HOME/.config/herdr/config.toml"
for plugin_dir in "${current_dir}"/herdr/plugins/*/; do
    plugin_id="$(basename "$plugin_dir")"
    mkdir -p "$HOME/.config/herdr/plugins/config/${plugin_id}"
    ln -sfnT "${plugin_dir}config.toml" "$HOME/.config/herdr/plugins/config/${plugin_id}/config.toml"
done

# Desktop: compositor, bar, launcher, notifications, volume display
link hypr ~/.config/hypr
link waybar ~/.config/waybar
link rofi ~/.config/rofi
link swaync ~/.config/swaync
link swayosd ~/.config/swayosd
link quickshell ~/.config/quickshell
link fastfetch ~/.config/fastfetch

# The desktop panel's weather needs a location. It is personal, so it is kept
# outside the repo; quickshell/location.example.json shows the format.
location_file="$HOME/.config/nocturne-location.json"
if [ ! -f "$location_file" ] && [ -t 0 ]; then
    if read -r -p "City for the desktop weather (leave empty to skip): " city && [[ -n "$city" ]]; then
        # Open-Meteo's geocoder. Names repeat across countries, so list the
        # matches and let the user pick. Coordinates are rounded to about 1 km.
        matches=$(curl -fsS --get "https://geocoding-api.open-meteo.com/v1/search" \
            --data-urlencode "name=$city" --data "count=5" |
            jq -c '[.results[]? | {name, area: ([.admin1, .country] | map(select(.)) | join(", ")),
                latitude: ((.latitude * 100 | round) / 100),
                longitude: ((.longitude * 100 | round) / 100), timezone}]') || matches='[]'
        count=$(jq length <<<"${matches:-[]}")
        if [ "$count" -gt 0 ]; then
            jq -r 'to_entries[] | "  \(.key + 1)) \(.value.name), \(.value.area)"' <<<"$matches"
            if read -r -p "Which one? [1-$count]: " choice &&
               [[ "$choice" =~ ^[1-5]$ ]] && (( choice <= count )); then
                jq ".[$((choice - 1))] | del(.area)" <<<"$matches" >"$location_file"
                echo "Saved the weather location to $location_file"
            fi
        else
            echo "No match for '$city'. Copy quickshell/location.example.json to $location_file and fill it in."
        fi
    fi
fi
link zathura ~/.config/zathura

# GTK and Qt apps
link gtk/gtk-3.0.css ~/.config/gtk-3.0/gtk.css
link gtk/gtk-4.0.css ~/.config/gtk-4.0/gtk.css
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
gsettings set org.gnome.desktop.interface font-name 'IBM Plex Sans 11'
gsettings set org.gnome.desktop.interface monospace-font-name 'Lilex Nerd Font 10'
gsettings set org.gnome.desktop.interface accent-color 'pink'
if [ ! -f ~/.config/qt6ct/qt6ct.conf ]; then
    mkdir -p ~/.config/qt6ct
    printf '[Appearance]\ncolor_scheme_path=%s\ncustom_palette=true\nstyle=Fusion\n' \
        "$HOME/.config/nocturne/qt6ct.conf" >~/.config/qt6ct/qt6ct.conf
fi

# Zen (Flatpak). The sandbox cannot see this repo, so allow read-only access
# to the zen folder only, then link its files into the default profile.
# Run Zen once first so the profile exists.
if flatpak info app.zen_browser.zen >/dev/null 2>&1; then
    flatpak override --user --filesystem="${current_dir}/zen:ro" app.zen_browser.zen
    zen_root="$HOME/.var/app/app.zen_browser.zen/.zen"
    zen_profile=""
    if [[ -f "$zen_root/installs.ini" ]]; then
        zen_profile=$(awk '/^Default=/ { sub(/^Default=/, ""); print; exit }' "$zen_root/installs.ini")
    fi
    if [[ -n "$zen_profile" ]]; then
        mkdir -p "$zen_root/$zen_profile/chrome"
        for f in userChrome.css userContent.css nocturne.css; do
            ln -sfn "${current_dir}/zen/chrome/$f" "$zen_root/$zen_profile/chrome/$f"
        done
        ln -sfn "${current_dir}/zen/user.js" "$zen_root/$zen_profile/user.js"
    fi
fi

# bat's Nocturne theme, also used by delta and ranger's previews
link bat ~/.config/bat
bat cache --build >/dev/null

# Git: shared settings only. Name, email and keys stay in ~/.gitconfig.
link git/config ~/.config/git/config
link git/ignore ~/.config/git/ignore

# GitHub CLI and its dashboard. Logins (gh/hosts.yml) stay out of the repo.
link gh/config.yml ~/.config/gh/config.yml
link gh-dash/config.yml ~/.config/gh-dash/config.yml

# Agent instructions and settings. Credentials and history stay in place.
# Herdr writes its own hook scripts: run `herdr integration install claude`
# and `herdr integration install codex` on each machine.
link claude/CLAUDE.md ~/.claude/CLAUDE.md
link claude/settings.json ~/.claude/settings.json
link claude/statusline.sh ~/.claude/statusline.sh
link codex/AGENTS.md ~/.codex/AGENTS.md

# Chromium-based browsers on Wayland
link chromium-flags.conf ~/.config/chromium-flags.conf
link chromium-flags.conf ~/.config/helium-browser-flags.conf

# Reload font cache
fc-cache

# Install code config
link Code/User/keybindings.json ~/.config/Code/User/keybindings.json
link Code/User/settings.json ~/.config/Code/User/settings.json

# Install zed config
mkdir -p ~/.config/zed
link zed/settings.json ~/.config/zed/settings.json
link zed/keymap.json ~/.config/zed/keymap.json
link zed/themes ~/.config/zed/themes

# Install bin
create_symlinks "bin" "$HOME/.local/bin/"

# Install pacman config
sudo cp "$current_dir/pacman.conf" /etc/pacman.conf

# Boot and Secure Boot files are not installed automatically; see system/README.md.

# Ranger dev icons
clone_if_missing https://github.com/alexanderjeurissen/ranger_devicons ~/.config/ranger/plugins/ranger_devicons
rm -rf ~/.config/ranger/rc.conf
rm -rf ~/.config/ranger/scope.sh
rm -rf ~/.config/ranger/rifle.conf
ln -s "${current_dir}/ranger/rc.conf" ~/.config/ranger/rc.conf
ln -s "${current_dir}/ranger/scope.sh" ~/.config/ranger/scope.sh
ln -s "${current_dir}/ranger/rifle.conf" ~/.config/ranger/rifle.conf
# Image previews in Ghostty, chafa drawings inside tmux or herdr
link ranger/plugins/ghostty_images.py ~/.config/ranger/plugins/ghostty_images.py

# Electron apps on Wayland
rm -f ~/.config/code-flags.conf
ln -s "${current_dir}/electron-flags.conf" ~/.config/code-flags.conf
rm -f ~/.config/webcord-flags.conf
ln -s "${current_dir}/electron-flags.conf" ~/.config/webcord-flags.conf
mkdir -p ~/.config/obsidian
ln -sfnT "${current_dir}/electron-flags.conf" ~/.config/obsidian/user-flags.conf

# Wayland desktop entries. Power actions live in the launcher (SUPER + SHIFT + E).
mkdir -p ~/.local/share/applications
ln -sf "${current_dir}/applications/discord-wayland.desktop" ~/.local/share/applications/discord-wayland.desktop
ln -sf "${current_dir}/applications/obsidian-wayland.desktop" ~/.local/share/applications/obsidian-wayland.desktop
ln -sf "${current_dir}/applications/chatgpt-wayland.desktop" ~/.local/share/applications/chatgpt-wayland.desktop

# Starship config
ln -sf "${current_dir}/starship.toml" ~/.config/starship.toml

# Enable bluetooth
sudo systemctl enable bluetooth.service --now

# Enable TLP power management
sudo systemctl enable tlp.service --now

# Configure virtual machines
sudo systemctl enable libvirtd.service --now
active_networks=$(sudo virsh net-list --name)
if ! grep -Fxq default <<< "$active_networks"; then
    sudo virsh net-start default
fi
sudo virsh net-autostart default

sudo usermod -aG libvirt $USER
sudo usermod -aG libvirt-qemu $USER
sudo usermod -aG kvm $USER
sudo usermod -aG docker $USER
sudo usermod -aG video $USER

flatpak override --filesystem=~/.themes:ro --filesystem=~/.icons:ro --user
mkdir -p ~/.icons

# Install zed
curl -fsSL https://zed.dev/install.sh | ZED_CHANNEL=preview sh

ln -sf "${current_dir}/zshrc" ~/.zshrc
if [[ ! -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]]; then
    omz_installer=$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)
    ZSH="$HOME/.oh-my-zsh" sh -c "$omz_installer" -- --unattended --keep-zshrc
fi

plugin_root="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins"
clone_if_missing https://github.com/zsh-users/zsh-syntax-highlighting.git "$plugin_root/zsh-syntax-highlighting"
clone_if_missing https://github.com/zsh-users/zsh-autosuggestions "$plugin_root/zsh-autosuggestions"
clone_if_missing https://github.com/joshskidmore/zsh-fzf-history-search "$plugin_root/zsh-fzf-history-search"

# Machine-specific settings and secrets go here, outside the repo.
touch ~/.custom_zshrc
