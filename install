#!/bin/bash
# Install the packages and link this repository's configuration into place.
# Warning: replaces existing configuration for every app listed in links.txt.
set -e -o pipefail

current_dir=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

clone_if_missing() {
    local url=$1 destination=$2
    if [[ ! -e "$destination/.git" ]]; then
        git clone -- "$url" "$destination"
    fi
}

# read_list FILE: the entries of a list file in this repo, without comments
# or blank lines.
read_list() {
    sed -E 's/[[:space:]]*#.*$//; /^[[:space:]]*$/d' "$current_dir/$1"
}

# link SOURCE TARGET: replace TARGET with a symlink to SOURCE in this repo.
link() {
    if [[ ! -e "$current_dir/$1" ]]; then
        printf 'Missing link source: %s\n' "$current_dir/$1" >&2
        return 1
    fi
    mkdir -p "$(dirname "$2")"
    rm -rf "$2"
    ln -s "${current_dir}/$1" "$2"
}

# Create every link listed in links.txt.
link_all() {
    local source target file
    while read -r source target; do
        target="${target/#\~/$HOME}"
        if [[ "$source" == */\* ]]; then
            for file in "$current_dir/${source%/\*}"/*; do
                if [[ -f "$file" ]]; then
                    link "${file#"$current_dir"/}" "${target%/}/$(basename "$file")"
                fi
            done
        else
            link "$source" "$target"
        fi
    done < <(read_list links.txt)
}

# gpu_lists: the graphics package lists for the GPUs in this machine, from the
# PCI vendor IDs the kernel reports. Other vendors get no list.
gpu_lists() {
    local vendor
    for vendor in /sys/class/drm/card*/device/vendor; do
        [[ -r "$vendor" ]] || continue
        case "$(<"$vendor")" in
            0x8086) echo packages/gpu-intel.txt ;;
            0x1002) echo packages/gpu-amd.txt ;;
        esac
    done | sort -u
}

mapfile -t packages < <(
    read_list packages/pacman.txt
    for list in $(gpu_lists); do read_list "$list"; done
)
# Filter out already installed packages
to_install=()
for pkg in "${packages[@]}"; do
    if ! pacman -Qq $pkg &>/dev/null; then
        to_install+=("$pkg")
    fi
done
if (( ${#to_install[@]} > 0 )); then
    sudo pacman -S --noconfirm "${to_install[@]}"
else
    echo "Dependencies already installed."
fi

# Install paru
if ! command -v paru >/dev/null; then
    (
        build_dir=$(mktemp -d)
        trap 'rm -rf -- "$build_dir"' EXIT
        git clone https://aur.archlinux.org/paru-bin.git "$build_dir"
        cd "$build_dir"
        makepkg -si --noconfirm
    )
else
    echo "Paru already installed."
fi

# Install AUR packages
mapfile -t aur_packages < <(read_list packages/aur.txt)
aur_to_install=()

for pkg in "${aur_packages[@]}"; do
    if ! pacman -Qq $pkg &>/dev/null; then
        aur_to_install+=("$pkg")
    fi
done
if (( ${#aur_to_install[@]} > 0 )); then
    paru -S --noconfirm --skipreview "${aur_to_install[@]}"
else
    echo "AUR dependencies already installed."
fi

# Install Flatpak apps
mapfile -t flatpak_apps < <(read_list packages/flatpak.txt)
flatpak_to_install=()
for app in "${flatpak_apps[@]}"; do
    if ! flatpak info "$app" &>/dev/null; then
        flatpak_to_install+=("$app")
    fi
done
if (( ${#flatpak_to_install[@]} > 0 )); then
    sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    sudo flatpak install --system --noninteractive flathub "${flatpak_to_install[@]}"
else
    echo "Flatpak apps already installed."
fi

# AstroNvim starts clean: its plugins and state are rebuilt from the config.
rm -rf ~/.local/share/nvim ~/.local/state/nvim ~/.cache/nvim

# Link the configuration into place. links.txt lists every link.
link_all

# tmux's plugin manager
clone_if_missing https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm

# Herdr's plugin configs, keeping runtime state outside the repository
for plugin_dir in "${current_dir}"/herdr/plugins/*/; do
    plugin_id="$(basename "$plugin_dir")"
    mkdir -p "$HOME/.config/herdr/plugins/config/${plugin_id}"
    ln -sfnT "${plugin_dir}config.toml" "$HOME/.config/herdr/plugins/config/${plugin_id}/config.toml"
done

# The desktop panel's weather needs a location. It is personal, so it is kept
# outside the repo; quickshell/location.example.json shows the format.
location_file="$HOME/.config/nocturne-location.json"
if [ ! -f "$location_file" ] && [ -t 0 ]; then
    if read -r -p "City for the desktop weather (leave empty to skip): " city && [[ -n "$city" ]]; then
        # Open-Meteo's geocoder. Names repeat across countries, so list the
        # matches and let the user pick. Coordinates are rounded to about 1 km.
        matches=$(curl -fsS --get "https://geocoding-api.open-meteo.com/v1/search" \
            --data-urlencode "name=$city" --data "count=5" |
            jq -c '[.results[]? | {name, area: ([.admin1, .country] | map(select(.)) | join(", ")),
                latitude: ((.latitude * 100 | round) / 100),
                longitude: ((.longitude * 100 | round) / 100), timezone}]') || matches='[]'
        count=$(jq length <<<"${matches:-[]}")
        if [ "$count" -gt 0 ]; then
            jq -r 'to_entries[] | "  \(.key + 1)) \(.value.name), \(.value.area)"' <<<"$matches"
            if read -r -p "Which one? [1-$count]: " choice &&
               [[ "$choice" =~ ^[1-5]$ ]] && (( choice <= count )); then
                jq ".[$((choice - 1))] | del(.area)" <<<"$matches" >"$location_file"
                echo "Saved the weather location to $location_file"
            fi
        else
            echo "No match for '$city'. Copy quickshell/location.example.json to $location_file and fill it in."
        fi
    fi
fi

# The cursor named in hypr/lua/env.lua. It is not in the official repos, so it
# comes from the project's own GitHub release: one pinned version, checked
# against a checksum recorded here before anything is unpacked. To move to a
# newer release, change the version and the checksum together.
cursor_theme=Bibata-Modern-Classic
cursor_version=v2.0.7
cursor_sha256=7d3495864e5bbef02f5e77de760b2905903b63c71495a78ef6306d19a3b556d8
install_cursor() {
    local download result
    download=$(mktemp -d) || return 1
    curl -fsSL -o "$download/cursor.tar.xz" \
        "https://github.com/ful1e5/Bibata_Cursor/releases/download/$cursor_version/$cursor_theme.tar.xz" &&
        echo "$cursor_sha256  $download/cursor.tar.xz" | sha256sum --check --quiet - &&
        mkdir -p ~/.local/share/icons &&
        tar -xf "$download/cursor.tar.xz" -C ~/.local/share/icons --no-same-owner
    result=$?
    rm -rf -- "$download"
    return $result
}
if [[ ! -d ~/.local/share/icons/$cursor_theme/cursors && ! -d /usr/share/icons/$cursor_theme/cursors ]]; then
    install_cursor || echo "Could not install the $cursor_theme cursor. Hyprland will use the default one." >&2
fi

# The icons named in rofi/config.rasi, and set for GTK and Qt apps below. They
# are not in the official repos and the project publishes no releases, so they
# come from its GitHub repository at one pinned commit, which git checks by its
# hash. The project's own install script puts the blue set, light and dark, in
# ~/.local/share/icons. To move to a newer version, change the commit.
icon_theme=Reversal-blue-dark
icon_commit=2c8122287e3bad5a6bf860ddd8c7e3b78cf4d451
install_icons() {
    local download result
    download=$(mktemp -d) || return 1
    git init -q "$download" &&
        git -C "$download" fetch -q --depth 1 \
            https://github.com/yeyushengfan258/Reversal-icon-theme "$icon_commit" &&
        git -C "$download" -c advice.detachedHead=false checkout -q FETCH_HEAD &&
        bash "$download/install.sh" -t blue >/dev/null
    result=$?
    rm -rf -- "$download"
    return $result
}
if [[ ! -d ~/.local/share/icons/$icon_theme && ! -d /usr/share/icons/$icon_theme ]]; then
    install_icons || echo "Could not install the $icon_theme icons. Apps will use the default ones." >&2
fi

# GTK and Qt apps
gsettings set org.gnome.desktop.interface icon-theme "$icon_theme"
gsettings set org.gnome.desktop.interface cursor-theme "$cursor_theme"
gsettings set org.gnome.desktop.interface cursor-size 20
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
gsettings set org.gnome.desktop.interface font-name 'IBM Plex Sans 11'
gsettings set org.gnome.desktop.interface monospace-font-name 'Lilex Nerd Font 10'
gsettings set org.gnome.desktop.interface accent-color 'pink'
if [ ! -f ~/.config/qt6ct/qt6ct.conf ]; then
    mkdir -p ~/.config/qt6ct
    printf '[Appearance]\ncolor_scheme_path=%s\ncustom_palette=true\nicon_theme=%s\nstyle=Fusion\n' \
        "$HOME/.config/nocturne/qt6ct.conf" "$icon_theme" >~/.config/qt6ct/qt6ct.conf
fi

# Thunderbird: link the Nocturne chrome and appearance prefs into the profile
# it starts with, the [Install...] entry in profiles.ini. Open Thunderbird once
# first so the profile exists.
thunderbird_root="$HOME/.thunderbird"
if [[ -f "$thunderbird_root/profiles.ini" ]]; then
    thunderbird_profile=$(awk -F= '/^\[Install/ { found = 1 } found && /^Default=/ { print $2; exit }' "$thunderbird_root/profiles.ini")
    if [[ -n "$thunderbird_profile" && -d "$thunderbird_root/$thunderbird_profile" ]]; then
        mkdir -p "$thunderbird_root/$thunderbird_profile/chrome"
        for f in userChrome.css userContent.css variables.css nocturne.css; do
            ln -sfn "${current_dir}/thunderbird/chrome/$f" "$thunderbird_root/$thunderbird_profile/chrome/$f"
        done
        ln -sfn "${current_dir}/thunderbird/user.js" "$thunderbird_root/$thunderbird_profile/user.js"
    fi
fi

# btop rewrites its own config, so only its theme is linked (links.txt). Select
# it here, keeping the rest of the config.
if [[ -f ~/.config/btop/btop.conf ]]; then
    sed -i 's/^color_theme = .*/color_theme = "nocturne"/' ~/.config/btop/btop.conf
else
    mkdir -p ~/.config/btop
    printf 'color_theme = "nocturne"\ntheme_background = false\n' >~/.config/btop/btop.conf
fi

# Vesktop (Vencord) rewrites its own settings, so only the theme is linked
# (links.txt). Select it here, keeping any other themes. Vesktop writes the
# file on its first start, and overwrites it while running, so close it first.
vencord_settings=~/.config/vesktop/settings/settings.json
if [[ -f "$vencord_settings" ]] && command -v jq >/dev/null; then
    jq '.enabledThemes = ((.enabledThemes // []) - ["nocturne.theme.css"] + ["nocturne.theme.css"])' \
        "$vencord_settings" >"$vencord_settings.new" && mv "$vencord_settings.new" "$vencord_settings"
fi

# Zen (Flatpak). The sandbox cannot see this repo, so allow read-only access
# to the zen folder only, then link its files into the default profile.
# Run Zen once first so the profile exists.
if flatpak info app.zen_browser.zen >/dev/null 2>&1; then
    flatpak override --user --filesystem="${current_dir}/zen:ro" app.zen_browser.zen
    zen_root="$HOME/.var/app/app.zen_browser.zen/.zen"
    zen_profile=""
    if [[ -f "$zen_root/installs.ini" ]]; then
        zen_profile=$(awk '/^Default=/ { sub(/^Default=/, ""); print; exit }' "$zen_root/installs.ini")
    fi
    if [[ -n "$zen_profile" ]]; then
        mkdir -p "$zen_root/$zen_profile/chrome"
        for f in userChrome.css userContent.css nocturne.css; do
            ln -sfn "${current_dir}/zen/chrome/$f" "$zen_root/$zen_profile/chrome/$f"
        done
        ln -sfn "${current_dir}/zen/user.js" "$zen_root/$zen_profile/user.js"
    fi
fi

# Obsidian keeps themes inside each vault, so link the Nocturne theme into
# every vault it knows about and select it in dark mode. The folder is real and
# its files are links: Obsidian reloads the theme when a link inside the vault
# is made again (`nocturne reload` does that), but not through a linked folder.
# Vaults opened later need ./install again.
obsidian_vaults="${XDG_CONFIG_HOME:-$HOME/.config}/obsidian/obsidian.json"
if [[ -f "$obsidian_vaults" ]]; then
    while read -r vault; do
        [[ -d "$vault/.obsidian" ]] || continue
        theme_dir="$vault/.obsidian/themes/Nocturne"
        [[ -L "$theme_dir" ]] && rm "$theme_dir"
        mkdir -p "$theme_dir"
        for f in manifest.json theme.css; do
            ln -sfn "${current_dir}/obsidian/themes/Nocturne/$f" "$theme_dir/$f"
        done
        appearance="$vault/.obsidian/appearance.json"
        [[ -s "$appearance" ]] || echo '{}' >"$appearance"
        jq '.cssTheme = "Nocturne" | .theme = "obsidian"' "$appearance" >"$appearance.tmp" &&
            mv "$appearance.tmp" "$appearance"
    done < <(jq -r '.vaults[].path' "$obsidian_vaults")
fi

# The wallpaper's moon follows the real one: paint tonight's now and each night
# after (systemd/user/nocturne-moon.timer, linked from links.txt).
systemctl --user daemon-reload
systemctl --user enable --now nocturne-moon.timer

# bat's Nocturne theme, also used by delta and ranger's previews
bat cache --build >/dev/null

# Agents: Herdr writes its own hook scripts. Run `herdr integration install
# claude` and `herdr integration install codex` on each machine.

# Reload font cache
fc-cache

# Install pacman config
sudo cp "$current_dir/pacman.conf" /etc/pacman.conf

# ChatGPT desktop, from OpenAI's own pacman repository. The copy above drops
# the repository's Include line, so add it back. The signing key is kept in
# packages/ and pinned by fingerprint. The repository file below matches what
# chatgpt-bin's install hook writes, so the hook keeps it and the key current.
openai_key=3BFA0E4AE8B8CC16A2D9BA684A3B4A566C4660E4
openai_repo=/etc/pacman.d/openai-chatgpt.conf
sudo pacman-key --add "$current_dir/packages/openai-chatgpt.asc"
sudo pacman-key --lsign-key "$openai_key"
if [[ ! -f "$openai_repo" ]]; then
    sudo tee "$openai_repo" >/dev/null <<'EOF'
### THIS FILE IS AUTOMATICALLY CONFIGURED ###
# Remove it and its Include line to opt out of automatic package updates.
[openai-chatgpt]
SigLevel = Required DatabaseRequired TrustedOnly
Server = https://persistent.oaistatic.com/codex-app-prod/linux/arch/$arch
EOF
fi
if ! grep -qxF "Include = $openai_repo" /etc/pacman.conf; then
    printf '\nInclude = %s\n' "$openai_repo" | sudo tee -a /etc/pacman.conf >/dev/null
fi
if ! pacman -Qq chatgpt-bin &>/dev/null; then
    # A new repository needs a sync, and Arch does not support partial upgrades.
    sudo pacman -Syu --needed --noconfirm chatgpt-bin
fi

# Boot and Secure Boot files are not installed automatically; see system/README.md.

# Ranger dev icons
clone_if_missing https://github.com/alexanderjeurissen/ranger_devicons ~/.config/ranger/plugins/ranger_devicons

# Enable bluetooth
sudo systemctl enable bluetooth.service --now

# Enable TLP power management, and tlp-pd, which answers tlpctl: the power
# profile in the launcher's power menu and the control centre's performance
# switch. TLP's manual asks for systemd-rfkill to be masked, so the two do not
# both restore the Wi-Fi and Bluetooth switches at boot.
sudo systemctl enable tlp.service --now
sudo systemctl enable tlp-pd.service --now
sudo systemctl mask systemd-rfkill.service systemd-rfkill.socket

# NetworkManager: the launcher's Wi-Fi menu and the control centre drive it
# with nmcli. Two network services fight over the same card, so when another
# one is running it is only enabled for the next boot.
sudo systemctl enable NetworkManager.service
if systemctl is-active --quiet iwd.service dhcpcd.service systemd-networkd.service; then
    echo "Another network service is running, so NetworkManager was not started." >&2
    echo "Disable that one (iwd, dhcpcd or systemd-networkd), then restart." >&2
else
    sudo systemctl start NetworkManager.service
fi

# Docker at boot
sudo systemctl enable docker.service --now

# Tailscale's daemon. Signing in is by hand: sudo tailscale up
sudo systemctl enable tailscaled.service --now

# Configure virtual machines
sudo systemctl enable libvirtd.service --now
active_networks=$(sudo virsh net-list --name)
if ! grep -Fxq default <<< "$active_networks"; then
    sudo virsh net-start default
fi
sudo virsh net-autostart default

sudo usermod -aG libvirt $USER
sudo usermod -aG libvirt-qemu $USER
sudo usermod -aG kvm $USER
sudo usermod -aG docker $USER
sudo usermod -aG video $USER

# zsh as the login shell; its config is zshrc, linked above
if [[ "$(getent passwd "$USER" | cut -d: -f7)" != */zsh ]]; then
    sudo chsh -s /usr/bin/zsh "$USER"
fi

flatpak override --filesystem=~/.themes:ro --filesystem=~/.icons:ro --user
mkdir -p ~/.icons

# Zed nightly, from Zed's own installer into ~/.local/zed-nightly.app
curl -fsSL https://zed.dev/install.sh | ZED_CHANNEL=nightly sh

# Starship, from its own installer into /usr/local/bin. Running it again
# updates it.
starship_installer=$(curl -fsSL https://starship.rs/install.sh)
sh -c "$starship_installer" -- --yes

# Herdr, from its own installer into ~/.local/bin, where SUPER + ALT + Return
# looks for it. The installer checks the download against a checksum. Herdr
# updates itself afterwards with `herdr update`.
if [[ ! -x ~/.local/bin/herdr ]]; then
    herdr_installer=$(curl -fsSL https://herdr.dev/install.sh)
    sh -c "$herdr_installer"
fi

if [[ ! -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]]; then
    omz_installer=$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)
    ZSH="$HOME/.oh-my-zsh" sh -c "$omz_installer" -- --unattended --keep-zshrc
fi

plugin_root="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins"
clone_if_missing https://github.com/zsh-users/zsh-syntax-highlighting.git "$plugin_root/zsh-syntax-highlighting"
clone_if_missing https://github.com/zsh-users/zsh-autosuggestions "$plugin_root/zsh-autosuggestions"
clone_if_missing https://github.com/joshskidmore/zsh-fzf-history-search "$plugin_root/zsh-fzf-history-search"

# Machine-specific settings and secrets go here, outside the repo.
touch ~/.custom_zshrc
