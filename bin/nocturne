#!/usr/bin/env bash
# nocturne: one command for the design system (see DESIGN.md).
#
#   nocturne                 show the current accent and this list
#   nocturne accent          list the accents
#   nocturne accent NAME     switch accent everywhere: colour files, wallpaper
#                            and the running apps
#   nocturne build           regenerate every colour file from nocturne/palette.toml
#   nocturne reload          make the running apps pick the colour files up
#   nocturne check           print the contrast table
#   nocturne doctor          check links, fonts, colour files and packages
#   nocturne unlisted        packages installed on purpose that packages/ does not list
#   nocturne greeter preview open the login screen in a window
#   nocturne greeter install install or update the login screen (needs sudo)
#
# After editing palette.toml by hand: nocturne build && nocturne reload.
set -uo pipefail

root="$(dirname "$(dirname "$(readlink -f "$0")")")"
palette="$root/nocturne/palette.toml"

usage() {
    sed -n '2,/^set -uo/{ /^set -uo/d; s/^# \{0,1\}//; p }' "$0"
}

running() {
    pgrep -x "$1" >/dev/null
}

# Obsidian keeps themes inside each vault. install gives every vault a
# themes/Nocturne folder holding links to the files in obsidian/themes/Nocturne.
# This prints the vaults Obsidian knows about.
obsidian_vaults() {
    local list="${XDG_CONFIG_HOME:-$HOME/.config}/obsidian/obsidian.json" vault
    [[ -f "$list" ]] && command -v jq >/dev/null || return 0
    while read -r vault; do
        [[ -d "$vault/.obsidian" ]] && printf '%s\n' "$vault"
    done < <(jq -r '.vaults[].path' "$list")
}

# ------------------------------------------------------------------- reload
# Each app is told in the gentlest way it supports. Apps that are not running
# are skipped; apps that cannot reload are named at the end.
reload() {
    local done=() restart=()

    if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && hyprctl reload >/dev/null 2>&1; then
        done+=("Hyprland")
    fi
    # SIGUSR2 reloads the bar in place, so it keeps the environment it was
    # started with, not this shell's.
    if pkill -USR2 -x waybar; then
        done+=("bar")
    fi
    if running swaync && swaync-client --reload-css >/dev/null 2>&1; then
        done+=("notifications")
    fi
    # The volume display reads its colours once, so it is restarted, by
    # Hyprland for the same reason as above.
    if running swayosd-server && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        pkill -x swayosd-server
        hyprctl dispatch 'hl.dsp.exec_cmd("swayosd-server")' >/dev/null 2>&1 && done+=("volume display")
    fi
    if pkill -USR2 -x ghostty; then
        done+=("terminal")
    fi
    if tmux list-sessions >/dev/null 2>&1 && tmux source-file ~/.config/nocturne/tmux.conf 2>/dev/null; then
        done+=("tmux")
    fi
    if running herdr && herdr server reload-config >/dev/null 2>&1; then
        done+=("Herdr")
    fi
    # Every running Neovim that uses the colour scheme reads the palette again.
    local socket reloaded_nvim=no
    local again='luaeval("(function() if vim.g.colors_name == \"nocturne\" then package.loaded[\"nocturne.palette\"] = nil; vim.cmd.colorscheme(\"nocturne\") end return 0 end)()")'
    for socket in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/nvim.*.0; do
        [[ -S "$socket" ]] || continue
        nvim --server "$socket" --remote-expr "$again" >/dev/null 2>&1 && reloaded_nvim=yes
    done
    [[ $reloaded_nvim == yes ]] && done+=("Neovim")

    # GNOME's named accent, for apps that ask the desktop for it.
    local gnome
    gnome="$("$root/nocturne/build" --accents | awk -F'\t' '$4 == "current" { print $3 }')"
    if [[ -n "$gnome" ]] && command -v gsettings >/dev/null; then
        gsettings set org.gnome.desktop.interface accent-color "$gnome" 2>/dev/null
    fi

    pgrep -f 'zen_browser|/zen( |$)|zen-bin' >/dev/null && restart+=("Zen")
    running firefox && restart+=("Firefox")
    running btop && restart+=("btop")
    # Obsidian does not notice when a linked file's target changes, but it
    # reloads the theme when the link itself is made again.
    local vault reloaded_obsidian=no
    while read -r vault; do
        [[ -L "$vault/.obsidian/themes/Nocturne/theme.css" ]] || continue
        ln -sfn "$root/obsidian/themes/Nocturne/theme.css" "$vault/.obsidian/themes/Nocturne/theme.css" &&
            reloaded_obsidian=yes
    done < <(obsidian_vaults)
    [[ $reloaded_obsidian == yes ]] && pgrep -f 'obsidian/app\.asar' >/dev/null && done+=("Obsidian")

    ((${#done[@]})) && printf 'reloaded: %s\n' "$(join ', ' "${done[@]}")"
    ((${#restart[@]})) && printf 'restart to see the change: %s\n' "$(join ', ' "${restart[@]}")"
    echo "Zed, VS Code, the launcher, the lock screen, the desktop panel and new shells follow on their own."
    greeter_note
}

join() { # separator, items...
    local separator=$1 out=$2
    shift 2
    local item
    for item in "$@"; do out+="$separator$item"; done
    printf '%s' "$out"
}

# ------------------------------------------------------------------ greeter
# The login screen runs as its own user, which cannot read a home folder. So
# it runs from root-owned copies, and only `nocturne greeter install` (with
# your password) updates them:
#   /usr/local/bin/nocturne-greeter.sh   what greetd starts
#   /etc/greetd/nocturne/                the screen itself: QML, colours and
#                                        the blurred wallpaper
greeter_repo="$root/system/usr/local/bin/nocturne-greeter.sh"
greeter_live=/usr/local/bin/nocturne-greeter.sh
greeter_dir=/etc/greetd/nocturne
greeter_stage="${XDG_CACHE_HOME:-$HOME/.cache}/nocturne/greeter"

# Put the screen's files together in the cache, ready to preview or install.
# The background is made from the current wallpaper, and only made again when
# the wallpaper or the palette changes.
stage_greeter() {
    local wallpaper stamp
    mkdir -p "$greeter_stage" || return 1
    cp "$root"/greeter/*.qml "$root"/greeter/*.sh "$root/greeter/rc.xml" "$greeter_stage/" || return 1
    wallpaper="$("$root/hypr/scripts/wallpaper" current)" || return 1
    stamp="$wallpaper $(stat -c '%Y %s' "$wallpaper") $(stat -c '%Y' "$palette" "$root/greeter/background" | tr '\n' ' ')"
    if [[ ! -f "$greeter_stage/background.png" || "$(cat "$greeter_stage.source" 2>/dev/null)" != "$stamp" ]]; then
        "$root/greeter/background" "$wallpaper" "$greeter_stage/background.png" >/dev/null || return 1
        printf '%s\n' "$stamp" >"$greeter_stage.source"
    fi
    stage_cursor
}

# The desktop's cursor, for the login screen too. The theme and size are the
# ones Hyprland is given in hypr/lua/env.lua. labwc reads them from a file
# named `environment` in its config folder. A theme kept in your home folder
# is copied along, because the login screen cannot read it there.
stage_cursor() {
    local theme size dir home_theme="" lines=()
    theme="$(sed -n 's/.*"XCURSOR_THEME", *"\([^"]*\)".*/\1/p' "$root/hypr/lua/env.lua" | head -1)"
    size="$(sed -n 's/.*"XCURSOR_SIZE", *"\([^"]*\)".*/\1/p' "$root/hypr/lua/env.lua" | head -1)"

    for dir in ~/.icons ~/.local/share/icons; do
        [[ -n "$theme" && -d "$dir/$theme/cursors" ]] && home_theme="$dir/$theme"
    done

    mkdir -p "$greeter_stage/icons" || return 1
    # Only the theme in use is kept in the stage.
    find "$greeter_stage/icons" -mindepth 1 -maxdepth 1 ! -name "$theme" -exec rm -rf {} +
    if [[ -n "$home_theme" ]]; then
        rsync -rl --delete "$home_theme/" "$greeter_stage/icons/$theme/" || return 1
        lines+=("XCURSOR_PATH=$greeter_dir/icons:/usr/share/icons")
    fi
    if [[ -n "$home_theme" || ( -n "$theme" && -d "/usr/share/icons/$theme/cursors" ) ]]; then
        lines+=("XCURSOR_THEME=$theme")
        [[ -n "$size" ]] && lines+=("XCURSOR_SIZE=$size")
    fi

    if ((${#lines[@]})); then
        printf '%s\n' "# Written by \`nocturne greeter install\`: the desktop's cursor, from hypr/lua/env.lua." \
            "${lines[@]}" >"$greeter_stage/environment"
    else
        rm -f "$greeter_stage/environment"
    fi
}

# absent: greetd does not use it. stale: the copies differ from this repo
# and the current wallpaper. current: nothing to do.
greeter_state() {
    if [[ ! -f "$greeter_live" ]] || ! grep -q nocturne-greeter.sh /etc/greetd/config.toml 2>/dev/null; then
        echo absent
    elif cmp -s "$greeter_repo" "$greeter_live" && stage_greeter 2>/dev/null &&
        [[ -d "$greeter_dir" && -z "$(rsync -rlc --delete --dry-run --itemize-changes "$greeter_stage/" "$greeter_dir/" 2>&1)" ]]; then
        echo current
    else
        echo stale
    fi
}

greeter_note() {
    if [[ "$(greeter_state)" == stale ]]; then
        echo "the login screen still has the old colours or wallpaper. Update it with: nocturne greeter install"
    fi
}

preview_greeter() {
    stage_greeter || {
        echo "nocturne: could not prepare the login screen (it needs python-numpy and python-pillow)" >&2
        return 1
    }
    echo "Opening the login screen in a window. It cannot log you in, and its power buttons do nothing."
    # Without greetd's socket the screen knows it is a preview.
    env -u GREETD_SOCK qs -p "$greeter_stage" >/dev/null 2>&1
}

install_greeter() {
    local missing=() command
    for command in greetd labwc wlr-randr qs tuigreet rsync; do
        command -v "$command" >/dev/null || missing+=("$command")
    done
    if ((${#missing[@]})); then
        printf 'nocturne: the login screen needs these first: %s\n' "$(join ', ' "${missing[@]}")" >&2
        echo "  sudo pacman -S --needed greetd greetd-tuigreet labwc wlr-randr quickshell rsync" >&2
        return 1
    fi
    stage_greeter || {
        echo "nocturne: could not prepare the login screen (it needs python-numpy and python-pillow)" >&2
        return 1
    }

    echo "Installing the login screen. sudo may ask for your password."
    # Mirror the stage: files that are no longer part of it are removed, and
    # everything ends up owned by root.
    sudo install -d -m755 "$greeter_dir" &&
        sudo rsync -rlc --delete --chmod=D755,F644 "$greeter_stage/" "$greeter_dir/" &&
        sudo install -m755 "$greeter_repo" "$greeter_live" || return 1

    if ! grep -q nocturne-greeter.sh /etc/greetd/config.toml 2>/dev/null; then
        local backup=/etc/greetd/config.toml.before-nocturne
        if [[ -f /etc/greetd/config.toml && ! -e "$backup" ]]; then
            sudo cp /etc/greetd/config.toml "$backup" || return 1
        fi
        sudo install -Dm644 "$root/system/etc/greetd/config.toml" /etc/greetd/config.toml || return 1
        echo "greetd is now set to start the Nocturne login screen. Its previous config is kept as $backup."
        # greetd reads its config once, when it starts, and it is the parent
        # of your session: restarting it now would end the session.
        echo "Done. greetd only reads its config when it starts, so you will see the new"
        echo "screen after restarting the computer. Logging out is not enough this first time."
    else
        echo "Done. You will see it the next time you log in."
    fi
    echo "If it ever fails to start, the text login takes over by itself."
}

# ------------------------------------------------------------------- accent
current_accent() {
    "$root/nocturne/build" --accents | awk -F'\t' '$4 == "current" { print $1 }'
}

list_accents() {
    local name hex gnome mark
    while IFS=$'\t' read -r name hex gnome mark; do
        # A swatch in the accent's own colour when writing to a terminal.
        if [[ -t 1 ]]; then
            printf '\e[38;2;%d;%d;%dm●\e[0m ' "0x${hex:1:2}" "0x${hex:3:2}" "0x${hex:5:2}"
        fi
        printf '%-8s %s%s\n' "$name" "$hex" "${mark:+  $mark}"
    done < <("$root/nocturne/build" --accents)
}

set_accent() {
    local name=$1
    if ! "$root/nocturne/build" --accents | cut -f1 | grep -Fxq -- "$name"; then
        printf 'nocturne: no accent named "%s". Choose from:\n' "$name" >&2
        list_accents >&2
        return 2
    fi
    if [[ "$(current_accent)" == "$name" ]]; then
        echo "The accent is already $name."
        return 0
    fi

    # palette.toml stays the one place the choice is recorded.
    sed -i -E "s/^accent = \"[^\"]*\"/accent = \"$name\"/" "$palette"
    "$root/nocturne/build" >/dev/null || return 1
    echo "accent: $name"
    reload

    # The moon is the accent too. Painting takes a few seconds, so it comes
    # last; the wallpaper is only swapped if the painted one is on screen.
    local painted="$root/hypr/wallpapers/nocturne.jpg"
    echo "repainting the wallpaper..."
    if "$root/nocturne/wallpaper" >/dev/null; then
        if [[ "$("$root/hypr/scripts/wallpaper" current 2>/dev/null)" == "$(readlink -f "$painted")" ]]; then
            "$root/hypr/scripts/wallpaper" set "$painted"
        fi
    else
        echo "nocturne: could not repaint the wallpaper (it needs python-numpy and python-pillow)" >&2
    fi
}

# ------------------------------------------------------------------- doctor
problems=0
ok() { printf '  ok    %s\n' "$1"; }
note() { printf '  note  %s\n' "$1"; }
fix() {
    printf '  fix   %s\n' "$1"
    problems=$((problems + 1))
}
detail() { printf '          %s\n' "$@"; }

# The entries of a list file in the repo, without comments or blank lines.
read_list() {
    sed -E 's/[[:space:]]*#.*$//; /^[[:space:]]*$/d' "$root/$1"
}

# The graphics package lists for the GPUs in this machine, as install picks them.
gpu_lists() {
    local vendor
    for vendor in /sys/class/drm/card*/device/vendor; do
        [[ -r "$vendor" ]] || continue
        case "$(<"$vendor")" in
            0x8086) echo packages/gpu-intel.txt ;;
            0x1002) echo packages/gpu-amd.txt ;;
        esac
    done | sort -u
}

# Every pacman and AUR package this machine should have: the main lists plus
# the graphics list for its GPUs.
listed_packages() {
    local list
    read_list packages/pacman.txt
    for list in $(gpu_lists); do read_list "$list"; done
    read_list packages/aur.txt
}

# Packages install puts in place itself rather than from a list.
installed_by_script=(chatgpt-bin paru paru-bin)

# Packages and Flatpak apps installed on purpose that no list in packages/
# covers, one per line: "pacman NAME", "aur NAME" or "flatpak APP".
unlisted_packages() {
    command -v pacman >/dev/null || return 0
    local known
    known=$(listed_packages; printf '%s\n' "${installed_by_script[@]}")
    comm -23 <(pacman -Qqen | sort) <(sort -u <<<"$known") | sed 's/^/pacman  /'
    comm -23 <(pacman -Qqem | sort) <(sort -u <<<"$known") | sed 's/^/aur     /'
    if command -v flatpak >/dev/null; then
        comm -23 <(flatpak list --app --columns=application | sort) <(read_list packages/flatpak.txt | sort) |
            sed 's/^/flatpak /'
    fi
}

unlisted() {
    local rows
    rows=$(unlisted_packages)
    if [[ -z "$rows" ]]; then
        echo "Everything installed on purpose is in packages/."
        return
    fi
    echo "Installed on purpose, but in no list in packages/ (pacman.txt, aur.txt, flatpak.txt):"
    printf '%s\n' "$rows" | sed 's/^/  /'
}

check_link() { # path in the repo, link
    [[ -L "$2" && "$(readlink -f "$2")" == "$(readlink -f "$root/$1")" ]]
}

doctor() {
    local stale
    if stale="$("$root/nocturne/build" --stale)"; then
        ok "colour files match the palette"
    else
        fix "colour files are out of date. Run: nocturne build"
        mapfile -t stale <<<"$stale"
        detail "${stale[@]}"
    fi

    if "$root/nocturne/build" --check >/dev/null; then
        ok "contrast: every text colour reaches 4.5:1"
    else
        fix "contrast: some text colours are below 4.5:1. See: nocturne check"
    fi

    local source target file count=0 wrong=()
    while read -r source target; do
        target="${target/#\~/$HOME}"
        if [[ "$source" == */\* ]]; then
            for file in "$root/${source%/\*}"/*; do
                [[ -f "$file" ]] || continue
                count=$((count + 1))
                check_link "${file#"$root"/}" "${target%/}/$(basename "$file")" ||
                    wrong+=("${target%/}/$(basename "$file")")
            done
        else
            count=$((count + 1))
            check_link "$source" "$target" || wrong+=("$target")
        fi
    done < <(read_list links.txt)
    if ((${#wrong[@]} == 0)); then
        ok "links: all $count point into this repo"
    else
        fix "links: ${#wrong[@]} of $count missing or pointing elsewhere. Run ./install, or link them by hand:"
        detail "${wrong[@]/#$HOME/\~}"
    fi

    local family missing=()
    for family in "IBM Plex Sans" "Lilex Nerd Font"; do
        [[ -n "$(fc-list "$family" family 2>/dev/null)" ]] || missing+=("$family")
    done
    if ((${#missing[@]} == 0)); then
        ok "fonts: IBM Plex Sans and Lilex Nerd Font"
    else
        fix "fonts not installed: $(join ', ' "${missing[@]}") (packages ttf-ibm-plex, ttf-lilex-nerd)"
    fi

    local cursor=Bibata-Modern-Classic dir found=no
    for dir in ~/.icons ~/.local/share/icons /usr/share/icons; do
        [[ -d "$dir/$cursor" ]] && found=yes
    done
    if [[ $found == yes ]]; then
        ok "cursor: $cursor"
    else
        fix "cursor theme $cursor is not installed (hypr/lua/env.lua asks for it). ./install downloads it"
    fi

    # pacman -T prints the packages that are not installed, counting ones
    # that another package provides.
    if command -v pacman >/dev/null; then
        local absent app
        mapfile -t absent < <(pacman -T $(listed_packages) 2>/dev/null)
        if command -v flatpak >/dev/null; then
            while read -r app; do
                flatpak info "$app" &>/dev/null || absent+=("$app")
            done < <(read_list packages/flatpak.txt)
        fi
        if ((${#absent[@]} == 0)); then
            ok "packages: everything in packages/ is installed"
        else
            note "packages listed in packages/ but not installed: $(join ' ' "${absent[@]}")"
        fi
        local unlisted_count
        unlisted_count=$(unlisted_packages | wc -l)
        if ((unlisted_count)); then
            note "$unlisted_count installed on purpose but in no list. See: nocturne unlisted"
        fi
    fi

    # Obsidian themes live inside each vault, so they are not in links.txt.
    local vault vaults unthemed=()
    mapfile -t vaults < <(obsidian_vaults)
    if ((${#vaults[@]})); then
        for vault in "${vaults[@]}"; do
            if ! check_link obsidian/themes/Nocturne/theme.css "$vault/.obsidian/themes/Nocturne/theme.css" ||
                ! check_link obsidian/themes/Nocturne/manifest.json "$vault/.obsidian/themes/Nocturne/manifest.json" ||
                [[ "$(jq -r '.cssTheme // ""' "$vault/.obsidian/appearance.json" 2>/dev/null)" != Nocturne ]]; then
                unthemed+=("$vault")
            fi
        done
        if ((${#unthemed[@]})); then
            fix "Obsidian: ${#unthemed[@]} vault(s) without the Nocturne theme. Run ./install:"
            detail "${unthemed[@]/#$HOME/\~}"
        else
            ok "Obsidian: every vault uses the Nocturne theme"
        fi
    fi

    case "$(greeter_state)" in
        absent) note "login screen: not installed. To use it: nocturne greeter install" ;;
        stale) note "login screen: the installed copy has older colours or wallpaper. Update it with: nocturne greeter install" ;;
        current) ok "login screen: the installed copy matches" ;;
    esac

    if [[ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/nocturne-location.json" ]]; then
        note "weather: no location set, so the desktop shows none (see quickshell/location.example.json)"
    fi

    if ((problems)); then
        printf '\n%d to fix.\n' "$problems"
        return 1
    fi
    printf '\nNothing to fix.\n'
}

# ------------------------------------------------------------------- main
case "${1:-}" in
    "")
        printf 'accent: %s\n\n' "$(current_accent)"
        usage
        ;;
    accent)
        if [[ -n "${2:-}" ]]; then set_accent "$2"; else list_accents; fi
        ;;
    greeter)
        case "${2:-}" in
            preview) preview_greeter ;;
            install) install_greeter ;;
            *)
                echo "usage: nocturne greeter {preview|install}" >&2
                exit 2
                ;;
        esac
        ;;
    build) "$root/nocturne/build" ;;
    reload) reload ;;
    check) "$root/nocturne/build" --check ;;
    doctor) doctor ;;
    unlisted) unlisted ;;
    -h | --help | help) usage ;;
    *)
        printf 'nocturne: unknown command "%s"\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
