# Generated by nocturne/build from nocturne/palette.toml. Edit that file, not this one.
# btop's Nocturne theme. Colour is information, and in a monitor that means
# two things: load runs green to gold to red as it climbs, and each kind of
# reading keeps a colour of its own so the eye can tell them apart (memory in
# foam, blue and iris; download blue, upload iris). Temperatures stay cool
# until they near the limit, so a normal 50 °C is never a warning.

# Text and surfaces. The background stays the terminal's (theme_background = false).
theme[main_bg]="#0f121e"
theme[main_fg]="#d9deec"
theme[title]="#f3f5fc"
# The letter that opens each box or option: something you can act on, so blue.
theme[hi_fg]="#8ab6f7"
theme[inactive_fg]="#80879d"
theme[graph_text]="#a1a7bb"
theme[proc_misc]="#8bd6de"

# The selected process is where you are: a selection, as in the editors.
theme[selected_bg]="#522a30"
theme[selected_fg]="#f3f5fc"

# One hairline for every box.
theme[cpu_box]="#30364a"
theme[mem_box]="#30364a"
theme[net_box]="#30364a"
theme[proc_box]="#30364a"
theme[div_line]="#30364a"
theme[meter_bg]="#30364a"

# Load: rising is a warning. btop places a value by its share of the maximum,
# so the middle colour is what half load looks like.
theme[cpu_start]="#7dd89f"
theme[cpu_mid]="#f2c36a"
theme[cpu_end]="#fc5950"
theme[used_start]="#7dd89f"
theme[used_mid]="#f2c36a"
theme[used_end]="#fc5950"
# Half the maximum temperature is normal, so the middle stays cool.
theme[temp_start]="#8bd6de"
theme[temp_mid]="#8bd6de"
theme[temp_end]="#fc5950"

# Amounts that are not a warning: one colour each, brighter as they grow.
theme[available_start]="#8bd6de"
theme[available_mid]="#8bd6de"
theme[available_end]="#9eeaf2"
theme[cached_start]="#8ab6f7"
theme[cached_mid]="#8ab6f7"
theme[cached_end]="#a5c9ff"
theme[free_start]="#c7a6ee"
theme[free_mid]="#c7a6ee"
theme[free_end]="#d9baff"
theme[download_start]="#8ab6f7"
theme[download_mid]="#8ab6f7"
theme[download_end]="#a5c9ff"
theme[upload_start]="#c7a6ee"
theme[upload_mid]="#c7a6ee"
theme[upload_end]="#d9baff"

# Each process's CPU, memory and graph, by value (proc_colors = true): load,
# so the same green to gold to red.
theme[process_start]="#7dd89f"
theme[process_mid]="#f2c36a"
theme[process_end]="#fc5950"

# Paused is a mode, so gold. Following a process is where you are, so the accent.
theme[proc_pause_bg]="#f2c36a"
theme[proc_follow_bg]="#f4a4ad"
theme[proc_banner_bg]="#222739"
theme[proc_banner_fg]="#f3f5fc"
theme[followed_bg]="#522a30"
theme[followed_fg]="#f3f5fc"
