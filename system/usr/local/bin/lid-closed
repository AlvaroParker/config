#!/bin/sh
# Succeeds when the laptop's lid is closed. The polkit PAM file in
# system/etc/pam.d runs it first, so with the lid shut (docked, on an external
# display) it skips the fingerprint sensor, which cannot be reached, and asks
# for the password straight away.
for state in /proc/acpi/button/lid/*/state; do
    /usr/bin/grep -qs closed "$state" && exit 0
done
exit 1
