{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 8,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 380,
  "control-center-height": 540,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": ["buttons-grid", "volume", "backlight", "mpris", "title", "notifications"],
  "widget-config": {
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰖩  Wi-Fi",
          "type": "toggle",
          "command": "~/.config/hypr/scripts/control wifi $SWAYNC_TOGGLE_STATE",
          "update-command": "~/.config/hypr/scripts/control wifi status"
        },
        {
          "label": "󰂯  Bluetooth",
          "type": "toggle",
          "command": "~/.config/hypr/scripts/control bluetooth $SWAYNC_TOGGLE_STATE",
          "update-command": "~/.config/hypr/scripts/control bluetooth status"
        },
        {
          "label": "󰖔  Night light",
          "type": "toggle",
          "command": "~/.config/hypr/scripts/control nightlight $SWAYNC_TOGGLE_STATE",
          "update-command": "~/.config/hypr/scripts/control nightlight status"
        },
        {
          "label": "󰂛  Do not disturb",
          "type": "toggle",
          "command": "~/.config/hypr/scripts/control dnd $SWAYNC_TOGGLE_STATE",
          "update-command": "~/.config/hypr/scripts/control dnd status"
        },
        {
          "label": "󰅶  Keep awake",
          "type": "toggle",
          "command": "~/.config/hypr/scripts/control awake $SWAYNC_TOGGLE_STATE",
          "update-command": "~/.config/hypr/scripts/control awake status"
        },
        {
          "label": "󱐋  Performance",
          "type": "toggle",
          "command": "~/.config/hypr/scripts/control performance $SWAYNC_TOGGLE_STATE",
          "update-command": "~/.config/hypr/scripts/control performance status"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰃟",
      "device": "intel_backlight"
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true,
      "loop-carousel": false
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    }
  }
}
