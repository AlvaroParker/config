// Nocturne bar: where you are on the left, the time in the middle, how the
// machine is on the right. Normal readings stay hidden and appear when
// something needs you: high CPU or memory, a live microphone, low battery.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap",
    "hyprland/window#app"
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "privacy",
    "custom/keep-awake",
    "cpu",
    "memory",
    "custom/updates",
    "custom/notifications",
    "tray",
    "network",
    "pulseaudio",
    "battery"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "all-outputs": true,
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  },

  "hyprland/submap": {
    "format": "{}",
    "tooltip": false
  },

  // The app name, readable. Unknown apps show their raw class.
  "hyprland/window#app": {
    "format": "{class}",
    "separate-outputs": true,
    "icon": false,
    "rewrite": {
      "com\\.mitchellh\\.ghostty": "Ghostty",
      "dev\\.zed\\..*": "Zed",
      "app\\.zen_browser\\.zen|zen.*": "Zen",
      "firefox.*": "Firefox",
      "org\\.pwmt\\.zathura": "Zathura",
      "org\\.gnome\\.Nautilus": "Files",
      "org\\.gnome\\.Settings": "Settings",
      "org\\.pulseaudio\\.pavucontrol|pavucontrol": "Volume",
      "blueman-manager|\\.blueman-manager-wrapped": "Bluetooth",
      "nm-connection-editor": "Network",
      "[Oo]bsidian": "Obsidian",
      "[Dd]iscord|vesktop": "Discord",
      "[Cc]ode|code-oss|code-url-handler": "VS Code",
      "teams-for-linux": "Teams",
      "[Ss]potify": "Spotify",
      "thunderbird|org\\.mozilla\\.Thunderbird": "Thunderbird",
      "google-chrome": "Chrome",
      "virt-manager": "Virtual machines",
      "[Cc]hat[Gg][Pp][Tt]": "ChatGPT",
      "Alacritty": "Alacritty"
    }
  },

  "clock": {
    "interval": 60,
    "format": "<span alpha='68%'>{0:%a %d %b}</span>  {0:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b><u>{}</u></b>"
      }
    },
    "on-click": "swaync-client --toggle-panel --skip-wait"
  },

  // Live microphone or screen share.
  "privacy": {
    "icon-size": 14,
    "icon-spacing": 6,
    "transition-duration": 200,
    "modules": [
      { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 18 },
      { "type": "audio-in", "tooltip": true, "tooltip-icon-size": 18 }
    ]
  },

  "custom/keep-awake": {
    "exec": "$HOME/.config/hypr/scripts/keep-awake waybar",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "on-click": "$HOME/.config/hypr/scripts/keep-awake off"
  },

  // Hidden below 85%.
  "cpu": {
    "interval": 5,
    "states": { "high": 85 },
    "format": "",
    "format-high": "󰍛 {usage}%",
    "tooltip": false
  },

  "memory": {
    "interval": 15,
    "states": { "high": 85 },
    "format": "",
    "format-high": "󰘚 {percentage}%",
    "tooltip-format": "{used:0.1f} of {total:0.1f} GiB in use"
  },

  "custom/updates": {
    "exec": "$HOME/.config/waybar/scripts/updates",
    "return-type": "json",
    "interval": 3600,
    "signal": 8
  },

  // A bell when notifications are waiting, a crossed bell in do-not-disturb.
  "custom/notifications": {
    "exec": "swaync-client --subscribe-waybar",
    "return-type": "json",
    "escape": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "on-click": "swaync-client --toggle-panel --skip-wait",
    "on-click-right": "swaync-client --toggle-dnd --skip-wait"
  },

  "tray": {
    "icon-size": 15,
    "spacing": 10,
    "show-passive-items": false
  },

  "network": {
    "interval": 10,
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤮 offline",
    "format-disabled": "󰤭 off",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "Wired · {ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Offline",
    "on-click": "$HOME/.config/rofi/launcher wifi",
    "on-click-right": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-bluetooth": "󰋋",
    "format-bluetooth-muted": "󰟎",
    "format-icons": {
      "headphone": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "tooltip-format": "{desc} · {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "swayosd-client --output-volume mute-toggle"
  },

  // The one number on the right. Padded so the bar never shifts.
  "battery": {
    "bat": "BAT0",
    "interval": 30,
    "states": { "warning": 20, "critical": 10 },
    "format": "{icon}{capacity:4}%",
    "format-charging": "󰂄{capacity:4}%",
    "format-plugged": "󰚥{capacity:4}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}"
  }
}
