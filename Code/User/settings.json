  "editor.tokenColorCustomizations": {
    "[Dark Modern]": {
      "textMateRules": [
        { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#80879d", "fontStyle": "" } },
        { "scope": ["string", "punctuation.definition.string", "markup.inline.raw", "markup.fenced_code.block", "markup.raw"], "settings": { "foreground": "#7dd89f" } },
        { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder", "markup.underline.link"], "settings": { "foreground": "#8bd6de" } },
        { "scope": ["constant", "constant.numeric", "constant.language", "support.constant", "variable.other.constant", "entity.name.label", "entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "meta.attribute"], "settings": { "foreground": "#f2c36a" } },
        { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.wordlike", "variable.language", "meta.preprocessor", "punctuation.section.embedded", "punctuation.definition.template-expression"], "settings": { "foreground": "#c7a6ee", "fontStyle": "" } },
        { "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function", "entity.name.tag", "string.other.link", "meta.link"], "settings": { "foreground": "#8ab6f7" } },
        { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.built-in", "storage.type.primitive", "keyword.type", "variable.other.enummember"], "settings": { "foreground": "#8bd6de" } },
        { "scope": ["variable", "variable.parameter", "variable.other.property", "meta.object-literal.key", "support.type.property-name", "entity.name.namespace", "meta.embedded", "source"], "settings": { "foreground": "#d9deec" } },
        { "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.definition.block", "punctuation.definition.parameters"], "settings": { "foreground": "#a1a7bb" } },
        { "scope": ["punctuation.separator", "punctuation.terminator", "punctuation.definition.tag", "punctuation.accessor"], "settings": { "foreground": "#80879d" } },
        { "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"], "settings": { "foreground": "#f3f5fc", "fontStyle": "bold" } },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        { "scope": ["punctuation.definition.list.begin"], "settings": { "foreground": "#f4a4ad" } },
        { "scope": ["markup.quote"], "settings": { "foreground": "#a1a7bb" } },
        { "scope": ["markup.inserted"], "settings": { "foreground": "#7dd89f" } },
        { "scope": ["markup.deleted", "invalid"], "settings": { "foreground": "#fc5950" } },
        { "scope": ["markup.changed"], "settings": { "foreground": "#f2c36a" } }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Dark Modern]": {
      "rules": {
        "comment": "#80879d",
        "string": "#7dd89f",
        "escapeSequence": "#8bd6de",
