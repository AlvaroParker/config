#!/usr/bin/env python3
"""Paint the Nocturne wallpaper: a cold night field with a single warm light.

    nocturne/wallpaper                      write hypr/wallpapers/nocturne.jpg
    nocturne/wallpaper --seed 11            a different range of hills
    nocturne/wallpaper --size 3072x1920 --out /tmp/test.png
    nocturne/wallpaper --phase tonight      tonight's moon, into
                                            ~/.local/state/nocturne/tonight.jpg
    nocturne/wallpaper --phase 0.3          any phase: 0 new, 0.5 full

The scene is a night sky over receding hills, with a low moon in the accent
colour seen through a lone rock arch shaped like the Arch Linux logo. Every
colour comes from nocturne/palette.toml, so changing the accent and re-running
this repaints the moon. Needs numpy and Pillow.

The file in the repo always has a full moon. Tonight's moon, in its real
phase and turned for your hemisphere, is painted outside the repo each night
(`nocturne moon`, from a systemd timer), and shown whenever the Nocturne
wallpaper is the one chosen.
"""

import argparse
import importlib.machinery
import importlib.util
import json
import math
import os
import tomllib
from datetime import datetime, timezone
from pathlib import Path

import numpy as np
from PIL import Image, ImageFilter

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent

HORIZON = 0.64

# Hill ranges from far to near. They bunch up towards the horizon, as distance
# compresses them, and grow larger and simpler up close.
#   base, amplitude, frequency, colour (L, C, hue offset), moon rim, glow kept
RANGES = [
    (HORIZON + 0.012, 0.045, 2.4, (0.235, 0.046, 6), 0.40, 0.45),
    (0.690, 0.050, 1.7, (0.200, 0.040, 4), 0.12, 0.20),
    (0.755, 0.065, 1.1, (0.170, 0.033, 2), 0.0, 0.08),
    (0.845, 0.080, 0.75, (0.142, 0.027, 0), 0.0, 0.03),
    (0.945, 0.100, 0.45, (0.115, 0.022, 0), 0.0, 0.0),
]

# The rock arch, in height units. Its outline is the Arch logo's: a sharp apex,
# flanks that flare out towards a wide base, a fold cut into the left face, and
# an arch underneath whose legs splay out at the feet.
LAKE_SHORE = 0.862     # the far shore of the lake in the nearest valley

PEAK_HEIGHT = 0.27     # apex to where the base would be
PEAK_HALF = 0.145      # half the width at the base
PEAK_FLARE = 0.82      # below 1 the flanks curve outwards, like the logo
ARCH_WIDTH = 0.40      # the cutout, as a fraction of the base's half width
ARCH_HEIGHT = 0.42     # and of the peak's height


def load_build():
    """Import nocturne/build (a script without .py) for its colour maths."""
    loader = importlib.machinery.SourceFileLoader("nocturne_build", str(HERE / "build"))
    spec = importlib.util.spec_from_loader("nocturne_build", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


build = load_build()


def linear(lightness, chroma, hue):
    """OKLCH to linear-light RGB, as a float32 array of three channels."""
    rgb = np.array(build.oklch_to_rgb(lightness, chroma, hue), dtype=np.float32) / 255.0
    return np.where(rgb <= 0.04045, rgb / 12.92, ((rgb + 0.055) / 1.055) ** 2.4)


def encode(channel):
    """Linear light to sRGB in 0..1."""
    channel = np.clip(channel, 0.0, 1.0)
    return np.where(channel <= 0.0031308, channel * 12.92, 1.055 * channel ** (1 / 2.4) - 0.055)


def ridge(x, rng, base, amplitude, frequency, octaves=6):
    """A hill line from 1D noise: rolling sines plus ridged noise for peaks.

    Image y grows downwards, so peaks are where the line goes up (smaller y).
    """
    smooth = np.zeros_like(x)
    peaks = np.zeros_like(x)
    total = 0.0
    for octave in range(octaves):
        weight = 0.5**octave
        f = frequency * 2.0**octave * rng.uniform(0.8, 1.25)
        smooth += weight * np.sin(2 * math.pi * f * x + rng.uniform(0, 2 * math.pi))
        peaks += weight * (1 - np.abs(np.sin(math.pi * f * x + rng.uniform(0, math.pi))))
        total += weight
    height = 0.5 * (smooth / total + 1) * 0.55 + (peaks / total) ** 2.2 * 0.6
    return base - amplitude * height


def peak_outline(Y, xs, rng, peak_x, apex_y):
    """Each pixel's distance below the arch's outer outline.

    Distance is measured across the slope, so the steep sides near the apex
    are antialiased as well as the gentle ones.
    """
    d = np.abs(xs - peak_x) / PEAK_HALF
    line = apex_y + PEAK_HEIGHT * d**PEAK_FLARE
    # A little weathering on the flanks, none at the apex, so it reads as rock.
    texture = ridge(xs, rng, 0.0, 0.014, 11.0, octaves=5)
    line = line - (texture - texture.mean()) * np.clip(d * 1.2, 0, 1)
    slope = np.gradient(line, xs)
    return (Y - line[None, :]) / np.sqrt(1 + slope * slope)[None, :]


def fold(X, Y, peak_x, apex_y):
    """The logo's fold: a shadowed gully that cuts into the left face from its
    edge and tapers to a point near the middle. 1 in the gully, 0 elsewhere."""
    u = (X - peak_x) / PEAK_HALF          # -1 at the left foot, 0 on the axis
    t = (Y - apex_y) / PEAK_HEIGHT        # 0 at the apex, 1 at the base
    s = np.clip(-u, 0, None)              # 0 at the tip, growing to the left
    centre = 0.47 + 0.24 * s**1.5         # rises towards the tip
    half = 0.085 * np.clip(s / 0.85, 0, 1) ** 1.6  # tapers to nothing at the tip
    inside = np.clip(1 - np.abs(t - centre) / np.maximum(half, 1e-4), 0, 1)
    return np.clip(inside * 2.2, 0, 1) * (u < 0)


def arch_cutout(X, Y, peak_x, base_y, pixel):
    """Signed distance to the arch under the logo, positive in the rock."""
    v = np.clip((base_y - Y) / (PEAK_HEIGHT * ARCH_HEIGHT), 0, None)
    flare = 1 + 0.75 * np.clip(1 - v, 0, 1) ** 3  # legs splay out at the feet
    u = np.abs(X - peak_x) / (PEAK_HALF * ARCH_WIDTH * flare)
    g = u**1.7 + v**2.2 - 1.0  # negative inside the cutout
    gy, gx = np.gradient(g, pixel)
    return g / np.maximum(np.sqrt(gx * gx + gy * gy), 1e-6)


# The moon's phase, worked out rather than looked up: a reference new moon
# (6 January 2000, 18:14 UTC) and the mean length of a lunar month. The real
# moon runs up to half a day ahead or behind, which a picture never shows.
NEW_MOON = datetime(2000, 1, 6, 18, 14, tzinfo=timezone.utc)
SYNODIC_DAYS = 29.530588853


def moon_phase(when):
    """Where the moon is in its month: 0 new, 0.25 first quarter, 0.5 full,
    0.75 last quarter."""
    days = (when - NEW_MOON).total_seconds() / 86400
    return (days / SYNODIC_DAYS) % 1.0


def southern_hemisphere():
    """From the weather location (install asks for it); north if unknown."""
    try:
        location = json.loads((Path.home() / ".config/nocturne-location.json").read_text())
        return float(location["latitude"]) < 0
    except (OSError, ValueError, KeyError, TypeError):
        return False


def sparkle_field(width, height, rng):
    """Light on rippled water: random noise, stretched sideways like ripples
    catching it, kept only at its peaks, then softened. 0 to 1.

    Soft on purpose: the moving wallpaper takes these out with a half-size
    copy and draws sharp glints of its own, and only soft streaks come out
    cleanly that way."""
    grid = rng.uniform(0, 1, (max(height // 3, 2), max(width // 14, 2))).astype(np.float32)
    noise = np.asarray(Image.fromarray(grid).resize((width, height), Image.BICUBIC))
    peaks = np.clip((noise - 0.80) / 0.20, 0, 1) ** 2
    grey = Image.fromarray((peaks * 255).astype(np.uint8), "L")  # the blur needs 8 bits
    soft = np.asarray(grey.filter(ImageFilter.GaussianBlur(max(height / 800, 1.5))), dtype=np.float32) / 255
    return np.clip(soft * 1.6, 0, 1)


def paint(width, height, seed, phase=0.5, south=False, live=False):
    """The wallpaper as an image. With live, also the layers the moving
    wallpaper (quickshell/LiveWallpaper.qml) animates, as a dict."""
    config = tomllib.loads((HERE / "palette.toml").read_text())
    hue = config["neutral"]["hue"]
    accent_l, accent_c, accent_h = config["accents"][config["accent"]]
    rng = np.random.default_rng(seed)
    # Separate streams for the lake and the stars' timing, so adding them never
    # changes the shape of the hills.
    lake_rng = np.random.default_rng(seed + 1000)
    twinkle_rng = np.random.default_rng(seed + 2000)

    # Coordinates in height units, so circles stay round on any aspect ratio.
    aspect = width / height
    ys = (np.arange(height, dtype=np.float32) + 0.5) / height
    xs = (np.arange(width, dtype=np.float32) + 0.5) / height
    X, Y = np.meshgrid(xs, ys)
    pixel = 1.0 / height

    lines = [ridge(xs, rng, base, amp, freq)[None, :] for base, amp, freq, *_ in RANGES]

    # Sky: the bar's ink-0 at the top, a dim blue-violet towards the horizon.
    stops_y = [0.0, 0.30, 0.50, HORIZON, 1.0]
    stops_c = [
        linear(0.145, 0.022, hue),
        linear(0.170, 0.030, hue),
        linear(0.215, 0.040, hue + 2),
        linear(0.285, 0.050, hue + 6),
        linear(0.285, 0.050, hue + 6),
    ]
    image = np.stack([np.interp(Y, stops_y, [c[i] for c in stops_c]) for i in range(3)], axis=-1)

    # The one warm light: a low moon, off-centre so the lock-screen clock never
    # sits on it, a third hidden behind the farthest range wherever that falls.
    moon_x, moon_r = aspect * 0.70, 0.019
    column = min(int(moon_x / pixel), width - 1)
    moon_y = float(lines[0][0, column]) - moon_r * 0.35

    # The rock arch stands one range nearer, the moon framed under its arch.
    peak_x = moon_x
    base_y = moon_y - moon_r - 0.020 + PEAK_HEIGHT * ARCH_HEIGHT
    apex_y = base_y - PEAK_HEIGHT
    peak_d = peak_outline(Y, xs, rng, peak_x, apex_y)
    cut_d = arch_cutout(X, Y, peak_x, base_y, pixel)
    peak_cover = np.clip(peak_d / pixel + 0.5, 0, 1) * np.clip(cut_d / pixel + 0.5, 0, 1)
    # Part the next range so the arch's flared feet show.
    span = np.exp(-(((xs - peak_x) / (PEAK_HALF * 1.1)) ** 4))[None, :]
    lines[1] = lines[1] * (1 - span) + np.maximum(lines[1], base_y + 0.004) * span
    # The nearest range opens below the moon, so the lake shows between its
    # two arms.
    opening = np.exp(-(((xs - moon_x) / 0.46) ** 4))[None, :]
    lines[4] = lines[4] * (1 - opening) + 1.06 * opening

    # How much of the moon is lit, 0 at new moon and 1 at full. The glow and the
    # light on the arch follow it, but never below 15%: the one warm light
    # stays, only dimmer on dark nights.
    lit = (1 - np.cos(2 * np.pi * phase)) / 2
    light = 0.15 + 0.85 * lit

    glow_color = linear(accent_l, accent_c, accent_h)
    dx, dy = (X - moon_x) / 1.6, Y - moon_y  # a wider-than-tall haze, like light on mist
    distance = np.sqrt(dx * dx + dy * dy)
    # Kept close to the moon, so the rest of the sky stays cold.
    glow = 0.34 * np.exp(-((distance / 0.032) ** 1.3)) + 0.09 * np.exp(-distance / 0.09) + 0.015 * np.exp(-distance / 0.3)
    glow *= light
    image += glow[..., None] * glow_color

    # Stars, fewer and fainter towards the horizon and the moon.
    sky_mask = np.clip((HORIZON - 0.12 - Y) / 0.2, 0, 1) * np.clip(distance / 0.25, 0, 1)
    stars = np.zeros((height, width), dtype=np.float32)
    count = int(260 * aspect / 1.6)
    sx = rng.uniform(0, width, count).astype(int)
    sy = (rng.beta(1.2, 2.6, count) * HORIZON * height).astype(int)
    brightness = rng.lognormal(-2.3, 0.7, count).clip(0, 0.6)
    stars[sy.clip(0, height - 1), sx.clip(0, width - 1)] = brightness
    stars = np.asarray(Image.fromarray(stars).resize((width // 2, height // 2), Image.BOX).resize((width, height), Image.BICUBIC))
    star_color = linear(0.95, 0.015, hue)
    image += (stars * 4.0 * sky_mask)[..., None] * star_color

    # What the moving wallpaper needs: how much of each animated thing is
    # still visible once everything in front is painted over it.
    star_seen = stars * 4.0 * sky_mask
    mist_seen = np.zeros((height, width), dtype=np.float32)
    glow_seen = glow.copy()  # the moon's glow in the sky; layers in front add theirs
    # Each star's own moment in its twinkle, over the few pixels it covers.
    star_timing = np.zeros((height, width), dtype=np.float32)
    for y, x in zip(sy.clip(0, height - 1), sx.clip(0, width - 1)):
        star_timing[max(y - 3, 0):y + 4, max(x - 3, 0):x + 4] = twinkle_rng.uniform(0.02, 1)

    def covered(cover):
        """Something opaque painted over: the animated parts behind it hide."""
        nonlocal star_seen, mist_seen, glow_seen
        star_seen = star_seen * (1 - cover)
        mist_seen = mist_seen * (1 - cover)
        glow_seen = glow_seen * (1 - cover)

    # The moon disc, slightly darker at its edge, drawn before the hills cover it.
    moon_d = np.sqrt((X - moon_x) ** 2 + (Y - moon_y) ** 2)
    moon_cover = np.clip((moon_r - moon_d) / pixel + 0.5, 0, 1)[..., None]
    limb = 1.0 - 0.18 * np.clip(moon_d / moon_r, 0, 1) ** 2
    # The lit part, bounded by the terminator: at each height v the edge
    # between light and shadow sits at u = cos(2 pi phase) times the disc's
    # half-width. It grows from the right in the north while waxing, and from
    # the left in the south, where the sky is seen the other way up.
    u = (X - moon_x) / moon_r
    v = (Y - moon_y) / moon_r
    if south:
        u = -u
    half = np.sqrt(np.clip(1 - v * v, 0, 1))
    edge = np.cos(2 * np.pi * phase) * half
    inside = u - edge if phase < 0.5 else -edge - u
    sunlit = np.clip(inside * moon_r / pixel + 0.5, 0, 1)
    # Within about seven hours of full or new, the terminator lies on the
    # disc's own edge; smoothing it there would dim the outline, so the disc
    # is simply all lit or all dark.
    if abs(phase - 0.5) < 0.01:
        sunlit = np.ones_like(sunlit)
    elif min(phase, 1 - phase) < 0.01:
        sunlit = np.zeros_like(sunlit)
    bright = linear(0.92, accent_c * 0.6, accent_h)
    # The dark part keeps a faint earthshine, so the moon never disappears.
    earthshine = linear(0.27, 0.035, hue + 4)
    moon = (bright * sunlit[..., None] + earthshine * (1 - sunlit[..., None])) * limb[..., None]
    image = image * (1 - moon_cover) + moon * moon_cover
    covered(moon_cover[..., 0])

    # Hills from far to near. Each is darker, less tinted by haze, and lit less
    # by the moon along its crest. Mist pools in the valley behind each one.
    mist_color = linear(0.34, 0.040, hue + 4)
    near_moon = np.exp(-(((X - moon_x) / 0.22) ** 2))
    moon_near = np.exp(-np.sqrt((X - moon_x) ** 2 + (Y - moon_y) ** 2) / 0.07)
    for index, (line, (_, _, _, (l, c, h), rim_strength, glow_kept)) in enumerate(zip(lines, RANGES)):
        if index == 1:
            # The arch, between the far range and the next: backlit by the
            # moon, with its inner edge and moon-side crest catching the light.
            fill = linear(0.212, 0.042, hue + 5)
            shade = 1.0 - 0.18 * np.clip((Y - apex_y) / PEAK_HEIGHT, 0, 1)
            shade *= 1.0 - 0.5 * fold(X, Y, peak_x, apex_y)
            layer = fill * shade[..., None] + (0.22 * glow)[..., None] * glow_color
            crest = np.exp(-np.clip(peak_d, 0, None) / 0.0016) * near_moon
            crest *= np.clip((X - peak_x) / 0.03 + 0.5, 0.15, 1)  # the moon's side
            rim = (0.12 * crest + 0.55 * np.exp(-np.clip(cut_d, 0, None) / 0.0020) * moon_near) * light
            layer += rim[..., None] * glow_color
            cover = peak_cover[..., None]
            image = image * (1 - cover) + layer * cover
            covered(peak_cover)
            glow_seen = glow_seen + 0.22 * glow * peak_cover

        if index == 4:
            # The lake, in the valley between the last two ranges: still water
            # holding the sky's colour, the far shore mirrored darker beneath
            # it, and the moon's light laid on it as a path of glints that
            # widens towards you.
            water_cover = np.clip((Y - LAKE_SHORE) / pixel + 0.5, 0, 1)
            depth = np.clip((Y - LAKE_SHORE) / (1 - LAKE_SHORE), 0, 1)[..., None]
            water = linear(0.205, 0.044, hue + 5) * (1 - depth) + linear(0.120, 0.030, hue + 3) * depth
            mirrored = LAKE_SHORE + (LAKE_SHORE - lines[3]) * 0.5
            reflection = np.clip((mirrored - Y) / pixel + 0.5, 0, 1) * (Y > LAKE_SHORE)
            water = water * (1 - 0.45 * reflection[..., None])
            out = np.clip(Y - LAKE_SHORE, 0, None)
            width_at = 0.010 + out * 0.32
            path = np.exp(-(((X - moon_x) / width_at) ** 2)) * np.exp(-out / 0.11) * (Y > LAKE_SHORE) * light
            sparkle = sparkle_field(width, height, lake_rng) * path
            shore = np.exp(-np.abs(Y - LAKE_SHORE) / 0.0012) * near_moon * light
            water = water + (0.10 * path + 0.9 * sparkle + 0.18 * shore)[..., None] * glow_color
            image = image * (1 - water_cover[..., None]) + water * water_cover[..., None]
            covered(water_cover)
            glints_seen = path * water_cover
            sparkle_seen = sparkle * water_cover

        below = Y - line
        cover = np.clip(below / pixel + 0.5, 0, 1)[..., None]

        mist = 0.12 * np.exp(-np.clip(-below, 0, None) / 0.035) * (below < 0)
        image += mist[..., None] * mist_color
        mist_seen = mist_seen + mist

        fill = linear(l, c, hue + h)
        shade = 1.0 - 0.2 * np.clip(below / 0.14, 0, 1)  # a touch darker further down
        layer = fill * shade[..., None] + (glow_kept * glow)[..., None] * glow_color
        # Moonlight catching the crest, only on far ranges and only near the moon.
        rim = rim_strength * np.exp(-np.clip(below, 0, None) / 0.0018) * near_moon * light
        layer += rim[..., None] * glow_color
        image = image * (1 - cover) + layer * cover
        covered(cover[..., 0])
        glow_seen = glow_seen + glow_kept * glow * cover[..., 0]
        if index == 4:
            glints_seen = glints_seen * (1 - cover[..., 0])
            sparkle_seen = sparkle_seen * (1 - cover[..., 0])

    # A gentle vignette keeps the corners quiet.
    cx, cy = (X - aspect / 2) / aspect, Y - 0.5
    vignette = 1 - 0.22 * np.clip((cx * cx + cy * cy) * 2.2, 0, 1)
    image *= vignette[..., None]

    # Fine grain and dithering, so the long gradients never band.
    out = encode(image) * 255.0
    out += rng.normal(0, 1.1, out.shape)
    out = np.floor(out + rng.uniform(0, 1, out.shape))
    picture = Image.fromarray(out.clip(0, 255).astype(np.uint8), "RGB")
    if not live:
        return picture

    # The layers, at half size: everything in them is soft. Amounts are scaled
    # to fill 0-255, and the scales go in the JSON so the shader can undo them.
    def channel(values, scale):
        small = Image.fromarray((values / scale).clip(0, 1).astype(np.float32) * 255.0)
        return small.convert("L").resize((width // 2, height // 2), Image.BOX)

    def timing_channel(values):
        # Nearest, not averaged: a star's timing must not blend with the sky's.
        small = Image.fromarray((values * 255.0).astype(np.uint8), "L")
        return small.resize((width // 2, height // 2), Image.NEAREST)

    scales = {
        "mist": float(max(mist_seen.max(), 1e-6) * float(vignette.max())),
        "stars": float(max(star_seen.max(), 1e-6)),
        "glints": float(max(glints_seen.max(), 1e-6)),
        "sparkle": float(max(sparkle_seen.max(), 1e-6)),
        "glow": float(max(glow_seen.max(), 1e-6)),
    }
    motion = Image.merge("RGB", (
        channel(mist_seen * vignette, scales["mist"]),
        channel(star_seen * vignette, scales["stars"]),
        timing_channel(star_timing),
    ))
    lake = Image.merge("RGB", (
        channel(glints_seen * vignette, scales["glints"]),
        channel(sparkle_seen * vignette, scales["sparkle"]),
        channel(glow_seen * vignette, scales["glow"]),
    ))
    settings = {
        "scales": scales,
        "mist": [float(v) for v in mist_color],
        "stars": [float(v) for v in star_color],
        "glow": [float(v) for v in glow_color],
        "moon": [float(moon_x / aspect), float(moon_y), float(light)],
        "shore": LAKE_SHORE,
        "aspect": width / height,
    }
    return picture, {"motion": motion, "lake": lake, "settings": settings}


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--size", default="3840x2400", help="WIDTHxHEIGHT, default 3840x2400")
    parser.add_argument("--seed", type=int, default=7, help="changes the shape of the hills")
    parser.add_argument("--out", help="default: the repo's wallpaper, or tonight.jpg for --phase tonight")
    parser.add_argument("--phase", default="full", help="full (default), tonight, or 0-1: 0 new, 0.5 full")
    parser.add_argument("--hemisphere", choices=["auto", "north", "south"], default="auto",
                        help="which way the moon is lit; auto reads the weather location")
    parser.add_argument("--live", help="also write the moving wallpaper's layers here "
                        "(done by default for --phase tonight, into live/ beside it)")
    args = parser.parse_args()

    if args.phase == "full":
        phase = 0.5
    elif args.phase == "tonight":
        # The phase this evening, at 21:00 local time, when the moon is looked at.
        evening = datetime.now().astimezone().replace(hour=21, minute=0, second=0, microsecond=0)
        phase = moon_phase(evening)
    else:
        phase = float(args.phase) % 1.0
    south = args.hemisphere == "south" or (args.hemisphere == "auto" and southern_hemisphere())
    if args.out:
        out = Path(args.out)
    elif args.phase == "tonight":
        state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
        out = state / "nocturne/tonight.jpg"
    else:
        out = ROOT / "hypr/wallpapers/nocturne.jpg"
    out.parent.mkdir(parents=True, exist_ok=True)

    width, height = (int(v) for v in args.size.lower().split("x"))
    # Tonight's picture is the one on screen, so the moving wallpaper's layers
    # are painted with it, into live/ beside it.
    live_dir = Path(args.live) if args.live else (out.parent / "live" if args.phase == "tonight" else None)
    if live_dir:
        image, layers = paint(width, height, args.seed, phase, south, live=True)
        live_dir.mkdir(parents=True, exist_ok=True)
        layers["motion"].save(live_dir / "motion.png")
        layers["lake"].save(live_dir / "lake.png")
        settings = dict(layers["settings"], image=str(out.resolve()))
        (live_dir / "live.json").write_text(json.dumps(settings, indent=1) + "\n")
    else:
        image = paint(width, height, args.seed, phase, south)
    if out.suffix.lower() in (".jpg", ".jpeg"):
        # JPEG at 95 with full colour resolution keeps the anti-banding grain;
        # WebP smooths it away and halves colour detail, which shows as bands.
        image.save(out, quality=95, subsampling=0)
    else:
        image.save(out)
    lit = (1 - math.cos(2 * math.pi * phase)) / 2
    print(f"wrote {out} ({width}x{height}, seed {args.seed}, moon {lit:.0%} lit)")


if __name__ == "__main__":
    main()
