#!/usr/bin/env python3
"""Paint the Nocturne wallpaper: a cold night field with a single warm light.

    nocturne/wallpaper                      write hypr/wallpapers/nocturne.jpg
    nocturne/wallpaper --seed 11            a different range of hills
    nocturne/wallpaper --size 3072x1920 --out /tmp/test.png

The scene is a night sky over receding hills, with a low moon in the accent
colour seen through a lone rock arch shaped like the Arch Linux logo. Every
colour comes from nocturne/palette.toml, so changing the accent and re-running
this repaints the moon. Needs numpy and Pillow.
"""

import argparse
import importlib.machinery
import importlib.util
import math
import tomllib
from pathlib import Path

import numpy as np
from PIL import Image

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent

HORIZON = 0.64

# Hill ranges from far to near. They bunch up towards the horizon, as distance
# compresses them, and grow larger and simpler up close.
#   base, amplitude, frequency, colour (L, C, hue offset), moon rim, glow kept
RANGES = [
    (HORIZON + 0.012, 0.045, 2.4, (0.235, 0.046, 6), 0.40, 0.45),
    (0.690, 0.050, 1.7, (0.200, 0.040, 4), 0.12, 0.20),
    (0.755, 0.065, 1.1, (0.170, 0.033, 2), 0.0, 0.08),
    (0.845, 0.080, 0.75, (0.142, 0.027, 0), 0.0, 0.03),
    (0.945, 0.100, 0.45, (0.115, 0.022, 0), 0.0, 0.0),
]

# The rock arch, in height units. Its outline is the Arch logo's: a sharp apex,
# flanks that flare out towards a wide base, a fold cut into the left face, and
# an arch underneath whose legs splay out at the feet.
PEAK_HEIGHT = 0.27     # apex to where the base would be
PEAK_HALF = 0.145      # half the width at the base
PEAK_FLARE = 0.82      # below 1 the flanks curve outwards, like the logo
ARCH_WIDTH = 0.40      # the cutout, as a fraction of the base's half width
ARCH_HEIGHT = 0.42     # and of the peak's height


def load_build():
    """Import nocturne/build (a script without .py) for its colour maths."""
    loader = importlib.machinery.SourceFileLoader("nocturne_build", str(HERE / "build"))
    spec = importlib.util.spec_from_loader("nocturne_build", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


build = load_build()


def linear(lightness, chroma, hue):
    """OKLCH to linear-light RGB, as a float32 array of three channels."""
    rgb = np.array(build.oklch_to_rgb(lightness, chroma, hue), dtype=np.float32) / 255.0
    return np.where(rgb <= 0.04045, rgb / 12.92, ((rgb + 0.055) / 1.055) ** 2.4)


def encode(channel):
    """Linear light to sRGB in 0..1."""
    channel = np.clip(channel, 0.0, 1.0)
    return np.where(channel <= 0.0031308, channel * 12.92, 1.055 * channel ** (1 / 2.4) - 0.055)


def ridge(x, rng, base, amplitude, frequency, octaves=6):
    """A hill line from 1D noise: rolling sines plus ridged noise for peaks.

    Image y grows downwards, so peaks are where the line goes up (smaller y).
    """
    smooth = np.zeros_like(x)
    peaks = np.zeros_like(x)
    total = 0.0
    for octave in range(octaves):
        weight = 0.5**octave
        f = frequency * 2.0**octave * rng.uniform(0.8, 1.25)
        smooth += weight * np.sin(2 * math.pi * f * x + rng.uniform(0, 2 * math.pi))
        peaks += weight * (1 - np.abs(np.sin(math.pi * f * x + rng.uniform(0, math.pi))))
        total += weight
    height = 0.5 * (smooth / total + 1) * 0.55 + (peaks / total) ** 2.2 * 0.6
    return base - amplitude * height


def peak_outline(Y, xs, rng, peak_x, apex_y):
    """Each pixel's distance below the arch's outer outline.

    Distance is measured across the slope, so the steep sides near the apex
    are antialiased as well as the gentle ones.
    """
    d = np.abs(xs - peak_x) / PEAK_HALF
    line = apex_y + PEAK_HEIGHT * d**PEAK_FLARE
    # A little weathering on the flanks, none at the apex, so it reads as rock.
    texture = ridge(xs, rng, 0.0, 0.014, 11.0, octaves=5)
    line = line - (texture - texture.mean()) * np.clip(d * 1.2, 0, 1)
    slope = np.gradient(line, xs)
    return (Y - line[None, :]) / np.sqrt(1 + slope * slope)[None, :]


def fold(X, Y, peak_x, apex_y):
    """The logo's fold: a shadowed gully that cuts into the left face from its
    edge and tapers to a point near the middle. 1 in the gully, 0 elsewhere."""
    u = (X - peak_x) / PEAK_HALF          # -1 at the left foot, 0 on the axis
    t = (Y - apex_y) / PEAK_HEIGHT        # 0 at the apex, 1 at the base
    s = np.clip(-u, 0, None)              # 0 at the tip, growing to the left
    centre = 0.47 + 0.24 * s**1.5         # rises towards the tip
    half = 0.085 * np.clip(s / 0.85, 0, 1) ** 1.6  # tapers to nothing at the tip
    inside = np.clip(1 - np.abs(t - centre) / np.maximum(half, 1e-4), 0, 1)
    return np.clip(inside * 2.2, 0, 1) * (u < 0)


def arch_cutout(X, Y, peak_x, base_y, pixel):
    """Signed distance to the arch under the logo, positive in the rock."""
    v = np.clip((base_y - Y) / (PEAK_HEIGHT * ARCH_HEIGHT), 0, None)
    flare = 1 + 0.75 * np.clip(1 - v, 0, 1) ** 3  # legs splay out at the feet
    u = np.abs(X - peak_x) / (PEAK_HALF * ARCH_WIDTH * flare)
    g = u**1.7 + v**2.2 - 1.0  # negative inside the cutout
    gy, gx = np.gradient(g, pixel)
    return g / np.maximum(np.sqrt(gx * gx + gy * gy), 1e-6)


def paint(width, height, seed):
    config = tomllib.loads((HERE / "palette.toml").read_text())
    hue = config["neutral"]["hue"]
    accent_l, accent_c, accent_h = config["accents"][config["accent"]]
    rng = np.random.default_rng(seed)

    # Coordinates in height units, so circles stay round on any aspect ratio.
    aspect = width / height
    ys = (np.arange(height, dtype=np.float32) + 0.5) / height
    xs = (np.arange(width, dtype=np.float32) + 0.5) / height
    X, Y = np.meshgrid(xs, ys)
    pixel = 1.0 / height

    lines = [ridge(xs, rng, base, amp, freq)[None, :] for base, amp, freq, *_ in RANGES]

    # Sky: the bar's ink-0 at the top, a dim blue-violet towards the horizon.
    stops_y = [0.0, 0.30, 0.50, HORIZON, 1.0]
    stops_c = [
        linear(0.145, 0.022, hue),
        linear(0.170, 0.030, hue),
        linear(0.215, 0.040, hue + 2),
        linear(0.285, 0.050, hue + 6),
        linear(0.285, 0.050, hue + 6),
    ]
    image = np.stack([np.interp(Y, stops_y, [c[i] for c in stops_c]) for i in range(3)], axis=-1)

    # The one warm light: a low moon, off-centre so the lock-screen clock never
    # sits on it, a third hidden behind the farthest range wherever that falls.
    moon_x, moon_r = aspect * 0.70, 0.019
    column = min(int(moon_x / pixel), width - 1)
    moon_y = float(lines[0][0, column]) - moon_r * 0.35

    # The rock arch stands one range nearer, the moon framed under its arch.
    peak_x = moon_x
    base_y = moon_y - moon_r - 0.020 + PEAK_HEIGHT * ARCH_HEIGHT
    apex_y = base_y - PEAK_HEIGHT
    peak_d = peak_outline(Y, xs, rng, peak_x, apex_y)
    cut_d = arch_cutout(X, Y, peak_x, base_y, pixel)
    peak_cover = np.clip(peak_d / pixel + 0.5, 0, 1) * np.clip(cut_d / pixel + 0.5, 0, 1)
    # Part the next range so the arch's flared feet show.
    span = np.exp(-(((xs - peak_x) / (PEAK_HALF * 1.1)) ** 4))[None, :]
    lines[1] = lines[1] * (1 - span) + np.maximum(lines[1], base_y + 0.004) * span

    glow_color = linear(accent_l, accent_c, accent_h)
    dx, dy = (X - moon_x) / 1.6, Y - moon_y  # a wider-than-tall haze, like light on mist
    distance = np.sqrt(dx * dx + dy * dy)
    # Kept close to the moon, so the rest of the sky stays cold.
    glow = 0.34 * np.exp(-((distance / 0.032) ** 1.3)) + 0.09 * np.exp(-distance / 0.09) + 0.015 * np.exp(-distance / 0.3)
    image += glow[..., None] * glow_color

    # Stars, fewer and fainter towards the horizon and the moon.
    sky_mask = np.clip((HORIZON - 0.12 - Y) / 0.2, 0, 1) * np.clip(distance / 0.25, 0, 1)
    stars = np.zeros((height, width), dtype=np.float32)
    count = int(260 * aspect / 1.6)
    sx = rng.uniform(0, width, count).astype(int)
    sy = (rng.beta(1.2, 2.6, count) * HORIZON * height).astype(int)
    brightness = rng.lognormal(-2.3, 0.7, count).clip(0, 0.6)
    stars[sy.clip(0, height - 1), sx.clip(0, width - 1)] = brightness
    stars = np.asarray(Image.fromarray(stars).resize((width // 2, height // 2), Image.BOX).resize((width, height), Image.BICUBIC))
    image += (stars * 4.0 * sky_mask)[..., None] * linear(0.95, 0.015, hue)

    # The moon disc, slightly darker at its edge, drawn before the hills cover it.
    moon_d = np.sqrt((X - moon_x) ** 2 + (Y - moon_y) ** 2)
    moon_cover = np.clip((moon_r - moon_d) / pixel + 0.5, 0, 1)[..., None]
    limb = 1.0 - 0.18 * np.clip(moon_d / moon_r, 0, 1) ** 2
    moon = linear(0.92, accent_c * 0.6, accent_h) * limb[..., None]
    image = image * (1 - moon_cover) + moon * moon_cover

    # Hills from far to near. Each is darker, less tinted by haze, and lit less
    # by the moon along its crest. Mist pools in the valley behind each one.
    mist_color = linear(0.34, 0.040, hue + 4)
    near_moon = np.exp(-(((X - moon_x) / 0.22) ** 2))
    moon_near = np.exp(-np.sqrt((X - moon_x) ** 2 + (Y - moon_y) ** 2) / 0.07)
    for index, (line, (_, _, _, (l, c, h), rim_strength, glow_kept)) in enumerate(zip(lines, RANGES)):
        if index == 1:
            # The arch, between the far range and the next: backlit by the
            # moon, with its inner edge and moon-side crest catching the light.
            fill = linear(0.212, 0.042, hue + 5)
            shade = 1.0 - 0.18 * np.clip((Y - apex_y) / PEAK_HEIGHT, 0, 1)
            shade *= 1.0 - 0.5 * fold(X, Y, peak_x, apex_y)
            layer = fill * shade[..., None] + (0.22 * glow)[..., None] * glow_color
            crest = np.exp(-np.clip(peak_d, 0, None) / 0.0016) * near_moon
            crest *= np.clip((X - peak_x) / 0.03 + 0.5, 0.15, 1)  # the moon's side
            rim = 0.12 * crest + 0.55 * np.exp(-np.clip(cut_d, 0, None) / 0.0020) * moon_near
            layer += rim[..., None] * glow_color
            cover = peak_cover[..., None]
            image = image * (1 - cover) + layer * cover

        below = Y - line
        cover = np.clip(below / pixel + 0.5, 0, 1)[..., None]

        mist = 0.12 * np.exp(-np.clip(-below, 0, None) / 0.035) * (below < 0)
        image += mist[..., None] * mist_color

        fill = linear(l, c, hue + h)
        shade = 1.0 - 0.2 * np.clip(below / 0.14, 0, 1)  # a touch darker further down
        layer = fill * shade[..., None] + (glow_kept * glow)[..., None] * glow_color
        # Moonlight catching the crest, only on far ranges and only near the moon.
        rim = rim_strength * np.exp(-np.clip(below, 0, None) / 0.0018) * near_moon
        layer += rim[..., None] * glow_color
        image = image * (1 - cover) + layer * cover

    # A gentle vignette keeps the corners quiet.
    cx, cy = (X - aspect / 2) / aspect, Y - 0.5
    image *= (1 - 0.22 * np.clip((cx * cx + cy * cy) * 2.2, 0, 1))[..., None]

    # Fine grain and dithering, so the long gradients never band.
    out = encode(image) * 255.0
    out += rng.normal(0, 1.1, out.shape)
    out = np.floor(out + rng.uniform(0, 1, out.shape))
    return Image.fromarray(out.clip(0, 255).astype(np.uint8), "RGB")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--size", default="3840x2400", help="WIDTHxHEIGHT, default 3840x2400")
    parser.add_argument("--seed", type=int, default=7, help="changes the shape of the hills")
    parser.add_argument("--out", default=str(ROOT / "hypr/wallpapers/nocturne.jpg"))
    args = parser.parse_args()

    width, height = (int(v) for v in args.size.lower().split("x"))
    image = paint(width, height, args.seed)
    out = Path(args.out)
    if out.suffix.lower() in (".jpg", ".jpeg"):
        # JPEG at 95 with full colour resolution keeps the anti-banding grain;
        # WebP smooths it away and halves colour detail, which shows as bands.
        image.save(out, quality=95, subsampling=0)
    else:
        image.save(out)
    print(f"wrote {out} ({width}x{height}, seed {args.seed})")


if __name__ == "__main__":
    main()
