# Generated by nocturne/build from nocturne/palette.toml. Edit that file, not this one.
# Nocturne for Ghostty. The sixteen colours here are what every terminal tool
# inherits: bat, delta, btop, eza, fastfetch, zsh highlighting.

background = {{ink-1}}
foreground = {{text}}

cursor-color = {{accent}}
cursor-text = {{ink-1}}

selection-background = {{accent-dim}}
selection-foreground = {{bright}}

search-background = {{accent-dim}}
search-foreground = {{bright}}
search-selected-background = {{accent}}
search-selected-foreground = {{ink-1}}

split-divider-color = {{line}}

# 0-7 normal, 8-15 bright. 8 is the grey for comments and autosuggestions.
palette = 0={{ink-3}}
palette = 1={{red}}
palette = 2={{green}}
palette = 3={{gold}}
palette = 4={{blue}}
palette = 5={{iris}}
palette = 6={{foam}}
palette = 7={{muted}}
palette = 8={{faint}}
palette = 9={{red-bright}}
palette = 10={{green-bright}}
palette = 11={{gold-bright}}
palette = 12={{blue-bright}}
palette = 13={{iris-bright}}
palette = 14={{foam-bright}}
palette = 15={{bright}}
