# Generated by nocturne/build from nocturne/palette.toml. Edit that file, not this one.
# Included from zathurarc. Pages are recoloured to window background and body text.

set default-bg                "{{ink-1}}"
set default-fg                "{{text}}"

set statusbar-bg              "{{ink-0}}"
set statusbar-fg              "{{faint}}"
set inputbar-bg               "{{ink-0}}"
set inputbar-fg               "{{text}}"

set notification-bg           "{{ink-2}}"
set notification-fg           "{{text}}"
set notification-error-bg     "{{ink-2}}"
set notification-error-fg     "{{red}}"
set notification-warning-bg   "{{ink-2}}"
set notification-warning-fg   "{{gold}}"

set completion-bg             "{{ink-2}}"
set completion-fg             "{{muted}}"
set completion-group-bg       "{{ink-2}}"
set completion-group-fg       "{{faint}}"
set completion-highlight-bg   "{{ink-3}}"
set completion-highlight-fg   "{{bright}}"

set index-bg                  "{{ink-1}}"
set index-fg                  "{{muted}}"
set index-active-bg           "{{ink-3}}"
set index-active-fg           "{{bright}}"

set render-loading-bg         "{{ink-1}}"
set render-loading-fg         "{{faint}}"

set recolor-lightcolor        "{{ink-1}}"
set recolor-darkcolor         "{{text}}"

set highlight-color           "{{accent-dim}}aa"
set highlight-fg              "{{bright}}"
set highlight-active-color    "{{accent}}88"
