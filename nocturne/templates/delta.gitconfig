# Generated by nocturne/build from nocturne/palette.toml. Edit that file, not this one.
# Included from git/config.

[delta]
    syntax-theme = Nocturne
    navigate = true
    line-numbers = true
    file-style = "{{bright}} bold"
    file-decoration-style = "{{line}} ul"
    hunk-header-style = "file line-number syntax"
    hunk-header-decoration-style = "{{line}} box"
    hunk-header-file-style = "{{muted}}"
    hunk-header-line-number-style = "{{faint}}"
    line-numbers-left-style = "{{ink-3}}"
    line-numbers-right-style = "{{ink-3}}"
    line-numbers-zero-style = "{{faint}}"
    line-numbers-minus-style = "{{red}}"
    line-numbers-plus-style = "{{green}}"
    minus-style = "syntax {{red-bg}}"
    minus-emph-style = "syntax {{red-bg-strong}}"
    plus-style = "syntax {{green-bg}}"
    plus-emph-style = "syntax {{green-bg-strong}}"
    zero-style = "syntax"
    blame-palette = "{{ink-1}} {{ink-2}}"
