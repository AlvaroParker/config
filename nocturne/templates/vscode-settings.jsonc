  // VS Code has no theme file to link, so Nocturne is written over the built-in
  // "Dark Modern" theme. Choosing another theme in VS Code turns it off.
  // The syntax mapping matches Zed and Neovim.
  "workbench.colorCustomizations": {
    "[Dark Modern]": {
      "focusBorder": "{{accent}}",
      "foreground": "{{text}}",
      "disabledForeground": "{{faint}}",
      "descriptionForeground": "{{muted}}",
      "errorForeground": "{{red}}",
      "icon.foreground": "{{muted}}",
      "selection.background": "{{accent-dim}}",
      "widget.shadow": "{{ink-0}}8c",
      "widget.border": "{{line}}",
      "sash.hoverBorder": "{{accent}}",
      "textLink.foreground": "{{blue}}",
      "textLink.activeForeground": "{{blue-bright}}",
      "textCodeBlock.background": "{{ink-2}}",
      "textBlockQuote.background": "{{ink-2}}",
      "textBlockQuote.border": "{{line}}",
      "textPreformat.foreground": "{{green}}",
      "textPreformat.background": "{{ink-2}}",
      "textSeparator.foreground": "{{line}}",

      "button.background": "{{accent}}",
      "button.foreground": "{{ink-1}}",
      "button.hoverBackground": "{{accent-bright}}",
      "button.secondaryBackground": "{{ink-3}}",
      "button.secondaryForeground": "{{text}}",
      "button.secondaryHoverBackground": "{{line}}",
      "checkbox.background": "{{ink-2}}",
      "checkbox.border": "{{line}}",
      "checkbox.foreground": "{{text}}",
      "dropdown.background": "{{ink-2}}",
      "dropdown.listBackground": "{{ink-2}}",
      "dropdown.border": "{{line}}",
      "dropdown.foreground": "{{text}}",
      "input.background": "{{ink-2}}",
      "input.foreground": "{{text}}",
      "input.border": "{{line}}",
      "input.placeholderForeground": "{{faint}}",
      "inputOption.activeBackground": "{{ink-3}}",
      "inputOption.activeBorder": "{{accent}}",
      "inputOption.activeForeground": "{{bright}}",
      "inputValidation.errorBackground": "{{red-bg}}",
      "inputValidation.errorBorder": "{{red}}",
      "inputValidation.warningBackground": "{{ink-2}}",
      "inputValidation.warningBorder": "{{gold}}",
      "inputValidation.infoBackground": "{{ink-2}}",
      "inputValidation.infoBorder": "{{blue}}",
      "scrollbar.shadow": "#00000000",
      "scrollbarSlider.background": "{{line}}99",
      "scrollbarSlider.hoverBackground": "{{line}}",
      "scrollbarSlider.activeBackground": "{{faint}}",
      "badge.background": "{{ink-3}}",
      "badge.foreground": "{{text}}",
      "progressBar.background": "{{accent}}",
      "keybindingLabel.background": "{{ink-3}}",
      "keybindingLabel.foreground": "{{text}}",
      "keybindingLabel.border": "{{line}}",
      "keybindingLabel.bottomBorder": "{{line}}",

      "list.activeSelectionBackground": "{{ink-3}}",
      "list.activeSelectionForeground": "{{bright}}",
      "list.inactiveSelectionBackground": "{{ink-2}}",
      "list.inactiveSelectionForeground": "{{text}}",
      "list.hoverBackground": "{{ink-2}}",
      "list.hoverForeground": "{{text}}",
      "list.focusBackground": "{{ink-3}}",
      "list.focusForeground": "{{bright}}",
      "list.focusOutline": "{{line}}",
      "list.highlightForeground": "{{accent}}",
      "list.focusHighlightForeground": "{{accent}}",
      "list.errorForeground": "{{red}}",
      "list.warningForeground": "{{gold}}",
      "list.dropBackground": "{{accent-dim}}99",
      "listFilterWidget.background": "{{ink-2}}",
      "tree.indentGuidesStroke": "{{ink-3}}",
      "tree.inactiveIndentGuidesStroke": "{{ink-2}}",

      "activityBar.background": "{{ink-0}}",
      "activityBar.foreground": "{{bright}}",
      "activityBar.inactiveForeground": "{{faint}}",
      "activityBar.border": "#00000000",
      "activityBar.activeBorder": "{{accent}}",
      "activityBarBadge.background": "{{accent}}",
      "activityBarBadge.foreground": "{{ink-1}}",
      "activityBarTop.foreground": "{{bright}}",
      "activityBarTop.inactiveForeground": "{{faint}}",
      "activityBarTop.activeBorder": "{{accent}}",
      "sideBar.background": "{{ink-0}}",
      "sideBar.foreground": "{{text}}",
      "sideBar.border": "{{ink-2}}",
      "sideBarTitle.foreground": "{{muted}}",
      "sideBarSectionHeader.background": "{{ink-0}}",
      "sideBarSectionHeader.foreground": "{{muted}}",
      "sideBarSectionHeader.border": "{{ink-2}}",

      "titleBar.activeBackground": "{{ink-0}}",
      "titleBar.activeForeground": "{{muted}}",
      "titleBar.inactiveBackground": "{{ink-0}}",
      "titleBar.inactiveForeground": "{{faint}}",
      "titleBar.border": "#00000000",
      "commandCenter.background": "{{ink-1}}",
