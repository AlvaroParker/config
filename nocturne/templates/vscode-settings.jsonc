      "commandCenter.activeForeground": "{{text}}",
      "menu.background": "{{ink-2}}",
      "menu.foreground": "{{text}}",
      "menu.selectionBackground": "{{ink-3}}",
      "menu.selectionForeground": "{{bright}}",
      "menu.separatorBackground": "{{line}}",
      "menu.border": "{{line}}",
      "menubar.selectionBackground": "{{ink-3}}",
      "menubar.selectionForeground": "{{bright}}",

      "editorGroup.border": "{{ink-2}}",
      "editorGroup.dropBackground": "{{accent-dim}}66",
      "editorGroupHeader.tabsBackground": "{{ink-0}}",
      "editorGroupHeader.tabsBorder": "#00000000",
      "editorGroupHeader.noTabsBackground": "{{ink-1}}",
      "tab.activeBackground": "{{ink-1}}",
      "tab.activeForeground": "{{bright}}",
      "tab.inactiveBackground": "{{ink-0}}",
      "tab.inactiveForeground": "{{faint}}",
      "tab.unfocusedActiveForeground": "{{muted}}",
      "tab.unfocusedInactiveForeground": "{{faint}}",
      "tab.hoverBackground": "{{ink-2}}",
      "tab.border": "{{ink-0}}",
      "tab.activeBorder": "#00000000",
      "tab.activeBorderTop": "#00000000",
      "tab.unfocusedActiveBorderTop": "#00000000",
      "tab.selectedBorderTop": "#00000000",
      "tab.lastPinnedBorder": "{{line}}",
      "tab.activeModifiedBorder": "{{gold}}",
      "tab.inactiveModifiedBorder": "{{gold}}80",
      "breadcrumb.background": "{{ink-1}}",
      "breadcrumb.foreground": "{{faint}}",
      "breadcrumb.focusForeground": "{{text}}",
      "breadcrumb.activeSelectionForeground": "{{bright}}",
      "breadcrumbPicker.background": "{{ink-2}}",

      "editor.background": "{{ink-1}}",
      "editor.foreground": "{{text}}",
      "editorLineNumber.foreground": "{{faint}}80",
      "editorLineNumber.activeForeground": "{{text}}",
      "editorCursor.foreground": "{{accent}}",
      "editorCursor.background": "{{ink-1}}",
      "editor.selectionBackground": "{{accent-dim}}",
      "editor.inactiveSelectionBackground": "{{accent-dim}}99",
      "editor.selectionHighlightBackground": "{{ink-3}}",
      "editor.wordHighlightBackground": "{{ink-3}}",
      "editor.wordHighlightStrongBackground": "{{ink-3}}",
      "editor.findMatchBackground": "{{accent}}66",
      "editor.findMatchHighlightBackground": "{{accent-dim}}",
      "editor.findRangeHighlightBackground": "{{ink-2}}",
      "editor.hoverHighlightBackground": "{{ink-3}}",
      "editor.lineHighlightBackground": "{{ink-2}}99",
      "editor.lineHighlightBorder": "#00000000",
      "editor.rangeHighlightBackground": "{{ink-2}}",
      "editor.stackFrameHighlightBackground": "{{gold}}1a",
      "editor.focusedStackFrameHighlightBackground": "{{green}}1a",
      "editorLink.activeForeground": "{{blue}}",
      "editorWhitespace.foreground": "{{line}}",
      "editorIndentGuide.background1": "{{ink-2}}",
      "editorIndentGuide.activeBackground1": "{{line}}",
      "editorRuler.foreground": "{{ink-2}}",
      "editorCodeLens.foreground": "{{faint}}",
      "editorBracketMatch.background": "{{ink-3}}",
      "editorBracketMatch.border": "#00000000",
      // Brackets are punctuation, not decoration: one colour for every pair.
      "editorBracketHighlight.foreground1": "{{muted}}",
      "editorBracketHighlight.foreground2": "{{muted}}",
      "editorBracketHighlight.foreground3": "{{muted}}",
      "editorBracketHighlight.foreground4": "{{muted}}",
      "editorBracketHighlight.foreground5": "{{muted}}",
      "editorBracketHighlight.foreground6": "{{muted}}",
      "editorBracketHighlight.unexpectedBracket.foreground": "{{red}}",
      "editorOverviewRuler.border": "#00000000",
      "editorError.foreground": "{{red}}",
      "editorWarning.foreground": "{{gold}}",
      "editorInfo.foreground": "{{blue}}",
      "editorHint.foreground": "{{faint}}",
      "editorGutter.background": "{{ink-1}}",
      "editorGutter.addedBackground": "{{green}}",
      "editorGutter.modifiedBackground": "{{gold}}",
      "editorGutter.deletedBackground": "{{red}}",
      "editorInlayHint.foreground": "{{faint}}",
      "editorInlayHint.background": "#00000000",
      "editorGhostText.foreground": "{{faint}}",
      "editorStickyScroll.background": "{{ink-1}}",
      "editorStickyScrollHover.background": "{{ink-2}}",
      "minimap.background": "{{ink-1}}",
      "minimapSlider.background": "{{line}}66",
      "minimapSlider.hoverBackground": "{{line}}99",
      "minimapSlider.activeBackground": "{{line}}",

      "diffEditor.insertedLineBackground": "{{green}}1f",
      "diffEditor.insertedTextBackground": "{{green}}3d",
      "diffEditor.removedLineBackground": "{{red}}1f",
      "diffEditor.removedTextBackground": "{{red}}3d",
      "diffEditor.diagonalFill": "{{ink-3}}",

      "editorWidget.background": "{{ink-2}}",
      "editorWidget.foreground": "{{text}}",
      "editorWidget.border": "{{line}}",
      "editorSuggestWidget.background": "{{ink-2}}",
      "editorSuggestWidget.foreground": "{{text}}",
      "editorSuggestWidget.border": "{{line}}",
      "editorSuggestWidget.highlightForeground": "{{accent}}",
      "editorSuggestWidget.focusHighlightForeground": "{{accent}}",
      "editorSuggestWidget.selectedBackground": "{{ink-3}}",
      "editorSuggestWidget.selectedForeground": "{{bright}}",
      "editorHoverWidget.background": "{{ink-2}}",
      "editorHoverWidget.border": "{{line}}",
      "peekView.border": "{{line}}",
      "peekViewEditor.background": "{{ink-2}}",
      "peekViewEditor.matchHighlightBackground": "{{accent-dim}}",
      "peekViewResult.background": "{{ink-0}}",
      "peekViewResult.matchHighlightBackground": "{{accent-dim}}",
      "peekViewResult.selectionBackground": "{{ink-3}}",
      "peekViewResult.selectionForeground": "{{bright}}",
      "peekViewTitle.background": "{{ink-0}}",
      "peekViewTitleLabel.foreground": "{{bright}}",
      "peekViewTitleDescription.foreground": "{{muted}}",

      "panel.background": "{{ink-1}}",
      "panel.border": "{{ink-2}}",
      "panelTitle.activeBorder": "{{accent}}",
      "panelTitle.activeForeground": "{{bright}}",
      "panelTitle.inactiveForeground": "{{faint}}",
      "panelInput.border": "{{line}}",

      // Debugging is a mode, so it is gold on the usual bar, not a new bar colour.
      "statusBar.background": "{{ink-0}}",
      "statusBar.foreground": "{{muted}}",
      "statusBar.border": "#00000000",
      "statusBar.noFolderBackground": "{{ink-0}}",
      "statusBar.noFolderForeground": "{{muted}}",
      "statusBar.debuggingBackground": "{{ink-0}}",
      "statusBar.debuggingForeground": "{{gold}}",
      "statusBarItem.hoverBackground": "{{ink-3}}",
      "statusBarItem.remoteBackground": "{{ink-0}}",
      "statusBarItem.remoteForeground": "{{muted}}",
      "statusBarItem.prominentBackground": "{{ink-3}}",
      "statusBarItem.errorBackground": "{{red-bg}}",
      "statusBarItem.errorForeground": "{{red}}",
      "statusBarItem.warningBackground": "{{ink-0}}",
      "statusBarItem.warningForeground": "{{gold}}",

      "notifications.background": "{{ink-2}}",
      "notifications.foreground": "{{text}}",
      "notifications.border": "{{line}}",
      "notificationCenterHeader.background": "{{ink-2}}",
      "notificationToast.border": "{{line}}",
      "notificationsErrorIcon.foreground": "{{red}}",
      "notificationsWarningIcon.foreground": "{{gold}}",
      "notificationsInfoIcon.foreground": "{{blue}}",
      "quickInput.background": "{{ink-2}}",
      "quickInput.foreground": "{{text}}",
      "quickInputTitle.background": "{{ink-2}}",
      "quickInputList.focusBackground": "{{ink-3}}",
      "quickInputList.focusForeground": "{{bright}}",
      "pickerGroup.border": "{{line}}",
      "pickerGroup.foreground": "{{muted}}",
      "debugToolBar.background": "{{ink-2}}",
      "settings.headerForeground": "{{bright}}",
      "settings.modifiedItemIndicator": "{{gold}}",
      "welcomePage.tileBackground": "{{ink-2}}",
      "walkThrough.embeddedEditorBackground": "{{ink-0}}",

      "gitDecoration.addedResourceForeground": "{{green}}",
      "gitDecoration.modifiedResourceForeground": "{{gold}}",
      "gitDecoration.deletedResourceForeground": "{{red}}",
      "gitDecoration.renamedResourceForeground": "{{blue}}",
      "gitDecoration.untrackedResourceForeground": "{{faint}}",
      "gitDecoration.ignoredResourceForeground": "{{faint}}",
      "gitDecoration.conflictingResourceForeground": "{{gold}}",
      "gitDecoration.stageModifiedResourceForeground": "{{gold}}",
      "gitDecoration.stageDeletedResourceForeground": "{{red}}",
      "gitDecoration.submoduleResourceForeground": "{{muted}}",

      "terminal.background": "{{ink-1}}",
      "terminal.foreground": "{{text}}",
      "terminal.border": "{{ink-2}}",
      "terminal.selectionBackground": "{{accent-dim}}",
      "terminalCursor.foreground": "{{accent}}",
      "terminalCursor.background": "{{ink-1}}",
      "terminal.ansiBlack": "{{ink-3}}",
      "terminal.ansiRed": "{{red}}",
      "terminal.ansiGreen": "{{green}}",
      "terminal.ansiYellow": "{{gold}}",
      "terminal.ansiBlue": "{{blue}}",
      "terminal.ansiMagenta": "{{iris}}",
      "terminal.ansiCyan": "{{foam}}",
      "terminal.ansiWhite": "{{muted}}",
      "terminal.ansiBrightBlack": "{{faint}}",
      "terminal.ansiBrightRed": "{{red-bright}}",
      "terminal.ansiBrightGreen": "{{green-bright}}",
      "terminal.ansiBrightYellow": "{{gold-bright}}",
      "terminal.ansiBrightBlue": "{{blue-bright}}",
      "terminal.ansiBrightMagenta": "{{iris-bright}}",
      "terminal.ansiBrightCyan": "{{foam-bright}}",
      "terminal.ansiBrightWhite": "{{bright}}"
    }
  },
  "editor.tokenColorCustomizations": {
    "[Dark Modern]": {
      "textMateRules": [
        { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{faint}}", "fontStyle": "" } },
        { "scope": ["string", "punctuation.definition.string", "markup.inline.raw", "markup.fenced_code.block", "markup.raw"], "settings": { "foreground": "{{green}}" } },
        { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder", "markup.underline.link"], "settings": { "foreground": "{{foam}}" } },
        { "scope": ["constant", "constant.numeric", "constant.language", "support.constant", "variable.other.constant", "entity.name.label", "entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "meta.attribute"], "settings": { "foreground": "{{gold}}" } },
        { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.wordlike", "variable.language", "meta.preprocessor", "punctuation.section.embedded", "punctuation.definition.template-expression"], "settings": { "foreground": "{{iris}}", "fontStyle": "" } },
        { "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function", "entity.name.tag", "string.other.link", "meta.link"], "settings": { "foreground": "{{blue}}" } },
        { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.built-in", "storage.type.primitive", "keyword.type", "variable.other.enummember"], "settings": { "foreground": "{{foam}}" } },
        { "scope": ["variable", "variable.parameter", "variable.other.property", "meta.object-literal.key", "support.type.property-name", "entity.name.namespace", "meta.embedded", "source"], "settings": { "foreground": "{{text}}" } },
        { "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.definition.block", "punctuation.definition.parameters"], "settings": { "foreground": "{{muted}}" } },
        { "scope": ["punctuation.separator", "punctuation.terminator", "punctuation.definition.tag", "punctuation.accessor"], "settings": { "foreground": "{{faint}}" } },
        { "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"], "settings": { "foreground": "{{bright}}", "fontStyle": "bold" } },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        { "scope": ["punctuation.definition.list.begin"], "settings": { "foreground": "{{accent}}" } },
        { "scope": ["markup.quote"], "settings": { "foreground": "{{muted}}" } },
        { "scope": ["markup.inserted"], "settings": { "foreground": "{{green}}" } },
        { "scope": ["markup.deleted", "invalid"], "settings": { "foreground": "{{red}}" } },
        { "scope": ["markup.changed"], "settings": { "foreground": "{{gold}}" } }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Dark Modern]": {
      "rules": {
        "comment": "{{faint}}",
        "string": "{{green}}",
        "escapeSequence": "{{foam}}",
        "formatSpecifier": "{{foam}}",
        "number": "{{gold}}",
        "boolean": "{{gold}}",
        "variable.constant": "{{gold}}",
        "label": "{{gold}}",
        "lifetime": "{{gold}}",
        "decorator": "{{gold}}",
        "builtinAttribute": "{{gold}}",
        "keyword": "{{iris}}",
        "selfKeyword": "{{iris}}",
        "function": "{{blue}}",
        "method": "{{blue}}",
        "macro": "{{blue}}",
        "type": "{{foam}}",
        "class": "{{foam}}",
        "struct": "{{foam}}",
        "enum": "{{foam}}",
        "interface": "{{foam}}",
        "typeParameter": "{{foam}}",
        "typeAlias": "{{foam}}",
        "builtinType": "{{foam}}",
        "selfTypeKeyword": "{{foam}}",
        "enumMember": "{{foam}}",
        "variable": "{{text}}",
        "parameter": "{{text}}",
        "property": "{{text}}",
        "namespace": "{{text}}",
        "operator": "{{muted}}",
        "punctuation": "{{muted}}"
      }
    }
  },
