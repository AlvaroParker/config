# Generated by nocturne/build from nocturne/palette.toml. Edit that file, not this one.
# Included from git/config.

[delta]
    syntax-theme = Nocturne
    navigate = true
    line-numbers = true
    file-style = "#f3f5fc bold"
    file-decoration-style = "#30364a ul"
    hunk-header-style = "file line-number syntax"
    hunk-header-decoration-style = "#30364a box"
    hunk-header-file-style = "#a1a7bb"
    hunk-header-line-number-style = "#80879d"
    line-numbers-left-style = "#222739"
    line-numbers-right-style = "#222739"
    line-numbers-zero-style = "#80879d"
    line-numbers-minus-style = "#fc5950"
    line-numbers-plus-style = "#7dd89f"
    minus-style = "syntax #341916"
    minus-emph-style = "syntax #562420"
    plus-style = "syntax #0d2818"
    plus-emph-style = "syntax #094024"
    zero-style = "syntax"
    blame-palette = "#0f121e #171b2a"
