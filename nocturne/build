#!/usr/bin/env python3
"""Render the Nocturne palette into every app's colour file.

    nocturne/build            regenerate all colour files
    nocturne/build --check    only print the contrast table
    nocturne/build --stale    list generated files that no longer match the
                              palette, without writing; fails if there are any
    nocturne/build --accents  list the accents: name, colour, nearest GNOME
                              accent, and "current" on the one in use

Reads nocturne/palette.toml, converts each OKLCH value to sRGB and writes:

  * palette dumps in the formats GTK, rofi, Hyprland and Neovim read,
  * the templates in nocturne/templates/, where {{token}} becomes #rrggbb,
    {{token:hex}} becomes rrggbb, {{token:rgb}} becomes "r, g, b" and
    {{token:qt}} becomes #ffrrggbb,
  * marked blocks inside starship.toml, herdr/config.toml and VS Code's
    settings.json.

Only the Python standard library is used. The `nocturne` command (bin/nocturne)
wraps this and reloads the running apps.
"""

import math
import re
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HERE = ROOT / "nocturne"
NOTICE = "Generated by nocturne/build from nocturne/palette.toml. Edit that file, not this one."

TEMPLATES = {
    "ghostty": "ghostty/themes/nocturne",
    "tmux.conf": "nocturne/tmux.conf",
    "zathura": "zathura/nocturne",
    "qt6ct.conf": "nocturne/qt6ct.conf",
    "fzfrc": "nocturne/fzfrc",
    "delta.gitconfig": "nocturne/delta.gitconfig",
    "firefox.css": "firefox/chrome/nocturne.css",
    "zed.json": "zed/themes/nocturne.json",
    "zen.css": "zen/chrome/nocturne.css",
    "zen-content.css": "zen/chrome/userContent.css",
    "zen-user.js": "zen/user.js",
    "quickshell.qml": "quickshell/Nocturne.qml",
    "greeter.sh": "system/usr/local/bin/nocturne-greeter.sh",
    "obsidian.css": "obsidian/themes/Nocturne/theme.css",
    "btop.theme": "btop/themes/nocturne.theme",
}

# Template name -> (file, start marker, end marker). Only the lines between
# the markers are replaced, so the rest of the file stays hand-written.
# Markers may be indented.
BLOCKS = {
    "starship-palette.toml": ("starship.toml", "# >>> nocturne palette", "# <<< nocturne palette"),
    "herdr-theme.toml": ("herdr/config.toml", "# >>> nocturne theme", "# <<< nocturne theme"),
    "vscode-settings.jsonc": ("Code/User/settings.json", "// >>> nocturne theme", "// <<< nocturne theme"),
}


# ---------------------------------------------------------------- colour maths
def oklch_to_linear_srgb(lightness, chroma, hue):
    a = chroma * math.cos(math.radians(hue))
    b = chroma * math.sin(math.radians(hue))
    l_ = lightness + 0.3963377774 * a + 0.2158037573 * b
    m_ = lightness - 0.1055613458 * a - 0.0638541728 * b
    s_ = lightness - 0.0894841775 * a - 1.2914855480 * b
    l, m, s = l_**3, m_**3, s_**3
    return (
        4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s,
    )


def encode(channel):
    channel = min(1.0, max(0.0, channel))
    if channel <= 0.0031308:
        return 255 * 12.92 * channel
    return 255 * (1.055 * channel ** (1 / 2.4) - 0.055)


def oklch_to_rgb(lightness, chroma, hue):
    """Convert to 8-bit sRGB, lowering chroma until the colour fits the gamut."""
    while chroma > 0:
        linear = oklch_to_linear_srgb(lightness, chroma, hue)
        if all(-0.0005 <= c <= 1.0005 for c in linear):
            break
        chroma -= 0.001
    linear = oklch_to_linear_srgb(lightness, max(chroma, 0), hue)
    return tuple(round(encode(c)) for c in linear)


def luminance(rgb):
    def lin(c):
        c /= 255
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4

    r, g, b = (lin(c) for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    hi, lo = sorted((luminance(a), luminance(b)), reverse=True)
    return (hi + 0.05) / (lo + 0.05)


# ---------------------------------------------------------------- tokens
def load_tokens():
    config = tomllib.loads((HERE / "palette.toml").read_text())
    neutral = dict(config["neutral"])
    hue = neutral.pop("hue")
    accent_name = config["accent"]
    if accent_name not in config["accents"]:
        sys.exit(f"palette.toml: accent '{accent_name}' is not listed under [accents]")

    oklch = {name: (l, c, hue) for name, (l, c) in neutral.items()}
    for name, (l, c, h) in config["semantic"].items():
        oklch[name] = (l, c, h)
        oklch[f"{name}-bright"] = (min(l + 0.06, 0.93), c, h)

    l, c, h = config["accents"][accent_name]
    oklch["accent"] = (l, c, h)
    oklch["accent-bright"] = (min(l + 0.06, 0.95), c, h)
    oklch["accent-dim"] = (0.34, min(0.06, c * 0.65), h)  # selection and search hits

    # Diff backgrounds: the semantic hue at window-background depth.
    for name in ("red", "green"):
        _, _, h = config["semantic"][name]
        oklch[f"{name}-bg"] = (0.25, 0.045, h)
        oklch[f"{name}-bg-strong"] = (0.33, 0.075, h)

    return accent_name, {name: oklch_to_rgb(*value) for name, value in oklch.items()}


# GNOME only has named accents. These are their hues, to pick the nearest.
GNOME_ACCENTS = {
    "pink": 0, "red": 28, "orange": 50, "yellow": 90,
    "green": 145, "teal": 200, "blue": 258, "purple": 310,
}


def gnome_accent(chroma, hue):
    """The GNOME accent closest to an OKLCH colour; slate for near-greys."""
    if chroma < 0.05:
        return "slate"
    return min(GNOME_ACCENTS, key=lambda name: abs((hue - GNOME_ACCENTS[name] + 180) % 360 - 180))


def list_accents():
    """One line per accent, tab-separated: name, #rrggbb, the nearest GNOME
    accent, and "current" on the one in use."""
    config = tomllib.loads((HERE / "palette.toml").read_text())
    for name, (lightness, chroma, hue) in config["accents"].items():
        mark = "\tcurrent" if name == config["accent"] else ""
        print(f"{name}\t#{hex_of(oklch_to_rgb(lightness, chroma, hue))}\t{gnome_accent(chroma, hue)}{mark}")


def hex_of(rgb):
    return "".join(f"{c:02x}" for c in rgb)


def fill(text, tokens):
    def replace(match):
        name, form = match.group(1), match.group(2)
        if name not in tokens:
            raise KeyError(f"unknown token '{name}'")
        rgb = tokens[name]
        if form == "hex":
            return hex_of(rgb)
        if form == "rgb":
            return ", ".join(str(c) for c in rgb)
        if form == "qt":
            return "#ff" + hex_of(rgb)
        return "#" + hex_of(rgb)

    return re.sub(r"\{\{([a-z0-9-]+)(?::(hex|rgb|qt))?\}\}", replace, text)


# ---------------------------------------------------------------- dumps
def dump_gtk(tokens):
    lines = [f"/* {NOTICE} */", "/* Colour names use underscores: @ink_0, @accent_dim. */", ""]
    lines += [f"@define-color {name.replace('-', '_')} #{hex_of(rgb)};" for name, rgb in tokens.items()]
    return "\n".join(lines) + "\n"


def dump_rasi(tokens):
    lines = [f"/* {NOTICE} */", "", "* {"]
    lines += [f"    {name}: #{hex_of(rgb)};" for name, rgb in tokens.items()]
    # Rasi has no alpha() function, so the glass surface is precomputed: ink-2 at 86%.
    lines += [f"    glass: #{hex_of(tokens['ink-2'])}db;"]
    return "\n".join(lines + ["}"]) + "\n"


def dump_hypr_lua(tokens):
    lines = [f"-- {NOTICE}", "", "local hex = {"]
    lines += [f'    ["{name}"] = "{hex_of(rgb)}",' for name, rgb in tokens.items()]
    lines += [
        "}",
        "",
        "local M = { hex = hex }",
        "",
        "--- Hyprland colour string for a token, for example rgb(f4a4ad).",
        "function M.rgb(name)",
        '    return "rgb(" .. assert(hex[name], name) .. ")"',
        "end",
        "",
        "--- Same, with alpha from 0 to 1, for example rgba(f4a4ad80).",
        "function M.rgba(name, alpha)",
        '    return string.format("rgba(%s%02x)", assert(hex[name], name), math.floor(alpha * 255 + 0.5))',
        "end",
        "",
        "return M",
    ]
    return "\n".join(lines) + "\n"


def dump_hyprlang(tokens):
    lines = [f"# {NOTICE}", "# Variables for hyprlock and other hyprlang configs: $ink_0, $accent_dim.", ""]
    lines += [f"${name.replace('-', '_')} = rgb({hex_of(rgb)})" for name, rgb in tokens.items()]
    return "\n".join(lines) + "\n"


def dump_nvim(tokens):
    lines = [f"-- {NOTICE}", "", "return {"]
    lines += [f'    ["{name}"] = "#{hex_of(rgb)}",' for name, rgb in tokens.items()]
    return "\n".join(lines + ["}"]) + "\n"


DUMPS = {
    "nocturne/palette.css": dump_gtk,
    "rofi/palette.rasi": dump_rasi,
    "hypr/lua/palette.lua": dump_hypr_lua,
    "hypr/palette.conf": dump_hyprlang,
    "nvim/lua/nocturne/palette.lua": dump_nvim,
}


# ---------------------------------------------------------------- output
def replace_block(relative, start, end, body):
    path = ROOT / relative
    text = path.read_text()
    pattern = re.compile(rf"(^[ \t]*{re.escape(start)}[^\n]*\n).*?(^[ \t]*{re.escape(end)})", re.S | re.M)
    if not pattern.search(text):
        sys.exit(f"{relative}: markers '{start}' and '{end}' not found")
    return pattern.sub(lambda m: m.group(1) + body + m.group(2), text, count=1)


def report(accent_name, tokens):
    bases = ("ink-0", "ink-1", "ink-2", "ink-3")
    rows = ("faint", "muted", "text", "bright", "accent", "red", "gold", "green", "blue", "foam", "iris")
    print(f"accent: {accent_name}  #{hex_of(tokens['accent'])}")
    print(f"{'contrast':<10}" + "".join(f"{b:>8}" for b in bases))
    failures = []
    for name in rows:
        ratios = [contrast(tokens[name], tokens[b]) for b in bases]
        print(f"{name:<10}" + "".join(f"{r:8.2f}" for r in ratios))
        # Text must reach 4.5:1 on every surface it sits on; ink-3 is a hover state.
        if any(r < 4.5 for r in ratios[:3]):
            failures.append(name)
    if failures:
        print("below 4.5:1 on a base surface: " + ", ".join(failures))
    return not failures


def render(tokens):
    """Every generated file: its path in the repo and what it should contain."""
    outputs = {}
    for relative, dump in DUMPS.items():
        outputs[relative] = dump(tokens)
    for template, relative in TEMPLATES.items():
        outputs[relative] = fill((HERE / "templates" / template).read_text(), tokens)
    for template, (relative, start, end) in BLOCKS.items():
        body = fill((HERE / "templates" / template).read_text(), tokens)
        outputs[relative] = replace_block(relative, start, end, body)
    return outputs


def main():
    args = sys.argv[1:]
    if "--accents" in args:
        list_accents()
        return

    accent_name, tokens = load_tokens()
    outputs = render(tokens)
    stale = [
        relative
        for relative, content in outputs.items()
        if not (ROOT / relative).exists() or (ROOT / relative).read_text() != content
    ]
    if "--stale" in args:
        print("\n".join(stale), end="\n" if stale else "")
        sys.exit(1 if stale else 0)

    passed = report(accent_name, tokens)
    if "--check" in args:
        sys.exit(0 if passed else 1)

    for relative in stale:
        path = ROOT / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(outputs[relative])

    print("\n" + ("updated:\n  " + "\n  ".join(stale) if stale else "everything is up to date"))


if __name__ == "__main__":
    main()
