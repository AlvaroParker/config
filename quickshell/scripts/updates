#!/usr/bin/env bash
# Pending package updates for the bar. Prints nothing when the system is up to
# date, so the module disappears.
set -uo pipefail

here="$(dirname "$(readlink -f "$0")")"
mapfile -t pending < <("$here/checkupdates" 2>/dev/null)
count=${#pending[@]}

((count == 0)) && exit 0

if ((count == 1)); then
    text="1 update"
else
    text="$count updates"
fi

# Tooltip: the first 20 package names, one per line, as a JSON string.
tooltip="$(printf '%s\n' "${pending[@]:0:20}" | awk '{print $1}' | jq -Rs 'rtrimstr("\n")')"
printf '{"text":"%s","tooltip":%s}\n' "$text" "$tooltip"
