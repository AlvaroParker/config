#!/usr/bin/env bash
# Take a screenshot, save it in ~/Pictures/Screenshots and copy it to the
# clipboard. SUPER + SHIFT + S asks which kind (rofi/scripts/screenshot);
# other keys call a kind directly.
#
#   screenshot region    drag over an area
#   screenshot window    click a window
#   screenshot display   the display under the pointer
#   screenshot all       every display
#
# While you pick an area or a window, the screen is frozen, so menus and
# tooltips hold still. Esc cancels quietly.
set -uo pipefail

dir="$HOME/Pictures/Screenshots"
file="$dir/Screenshot-$(date +%Y-%m-%d_%H:%M:%S).png"

notify() { # message, icon, app, timeout
    notify-send -a "$3" -i "$2" -t "$4" "$1"
}

fail() {
    notify "$1" dialog-error grim 2000
    exit 1
}

freeze_pid=""
cleanup() {
    [[ -n "$freeze_pid" ]] && kill "$freeze_pid" 2>/dev/null
}
trap cleanup EXIT

freeze() {
    if command -v hyprpicker >/dev/null; then
        hyprpicker -r -z >/dev/null 2>&1 &
        freeze_pid=$!
        sleep 0.2
    fi
    hyprctl keyword layerrule "noanim,selection" >/dev/null 2>&1 || true
}


capture() { # grim arguments...
    mkdir -p "$dir" || fail "Could not create $dir"
    grim "$@" "$file" || fail "Could not take the screenshot"
}

copy() {
    wl-copy --type image/png <"$file"
}

# Make the corners outside a rounded window transparent, anti-aliased, so the
# picture has the window's own shape. Only the corners are masked, so even a
# window at 2x scale costs a few kilobytes of mask.
round_corners() { # radius and width, in layout pixels
    python3 -I - "$file" "$1" "$2" <<'EOF' || fail "Could not round the window's corners"
import math
import sys

from PIL import Image, ImageDraw

path, radius, width = sys.argv[1], float(sys.argv[2]), float(sys.argv[3])
image = Image.open(path).convert("RGBA")
r = radius * image.width / width  # in image pixels
n = math.ceil(r)
if n > 0:
    ss = 4  # supersampling for a smooth edge
    tile = Image.new("L", (n * ss, n * ss), 0)
    draw = ImageDraw.Draw(tile)
    draw.ellipse((0, 0, 2 * r * ss, 2 * r * ss), fill=255)
    draw.rectangle((r * ss, 0, n * ss, n * ss), fill=255)
    draw.rectangle((0, r * ss, n * ss, n * ss), fill=255)
    tile = tile.resize((n, n), Image.BOX)  # an average: no ringing at the edge

    mask = Image.new("L", image.size, 255)
    w, h = image.size
    mask.paste(tile, (0, 0))
    mask.paste(tile.transpose(Image.FLIP_LEFT_RIGHT), (w - n, 0))
    mask.paste(tile.transpose(Image.FLIP_TOP_BOTTOM), (0, h - n))
    mask.paste(tile.transpose(Image.ROTATE_180), (w - n, h - n))
    image.putalpha(mask)
image.save(path)
EOF
}

case "${1:-region}" in
    region)
        freeze
        geometry=$(slurp) || exit 0
        capture -g "$geometry"
        message="Screenshot of the region taken"
        ;;
    window)
        freeze
        choice=$("$(dirname "$0")/window-boxes" | slurp -r -f '%x,%y %w %h %l') || exit 0
        read -r x_y w h label <<<"$choice"
        radius=${label%%:*}
        class=${label#*:}
        capture -g "$x_y ${w}x$h"
        round_corners "$radius" "$w"
        message="Screenshot of ${class:-the window} taken"
        ;;
    display)
        monitor=$(hyprctl monitors -j | jq -r '.[] | select(.focused).name')
        [[ -n "$monitor" ]] || fail "Could not find the display"
        capture -o "$monitor"
        message="Screenshot of $monitor taken"
        ;;
    all)
        capture
        message="Screenshot of every display taken"
        ;;
    *)
        printf 'usage: screenshot [region|window|display|all]\n' >&2
        exit 2
        ;;
esac

cleanup
freeze_pid=""
copy || fail "Could not copy the screenshot"
# Clicking the notification shows the file in Files. It waits in the
# background for 3 seconds (hovering keeps it open), so the script never hangs.
setsid -f bash -c '
    action=$(notify-send -a wl-copy -i "$1" -t 3000 -A default="Show in Files" "$2" "Click to show it in Files")
    [[ $action == default ]] && exec nautilus --select "$1"
' _ "$file" "$message" >/dev/null 2>&1
