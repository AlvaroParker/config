#!/usr/bin/env bash
# One quiet status line for the lock screen: battery and connection.
# Prints words, not network or device names.

battery_dir="/sys/class/power_supply/BAT0"
parts=()

if [[ -r "$battery_dir/capacity" ]]; then
    capacity=$(<"$battery_dir/capacity")
    status=$(<"$battery_dir/status")
    if [[ "$status" == "Charging" ]]; then
        parts+=("${capacity}% charging")
    else
        parts+=("${capacity}%")
    fi
fi

route=$(ip route get 1.1.1.1 2>/dev/null || true)
dev=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }' <<<"$route")
case "$dev" in
    "") parts+=("offline") ;;
    wl*) parts+=("Wi-Fi") ;;
    *) parts+=("wired") ;;
esac

line="${parts[0]}"
for part in "${parts[@]:1}"; do
    line+=" · $part"
done
printf '%s\n' "$line"
