#!/usr/bin/env bash
# rofi script mode: capture the screen (SUPER + SHIFT + S, and SUPER + ALT + R
# when nothing is recording). Screenshots first, with Region on top, so
# SUPER + SHIFT + S then Enter is the region screenshot it always was; then
# recordings. While one runs, Stop comes first.
# The work is done by hypr/scripts/screenshot and hypr/scripts/record.
set -uo pipefail

scripts="$HOME/.config/hypr/scripts"

row() { # label, hint, icon, action
    printf '%s  <span alpha="55%%">%s</span>\0icon\x1f%s\x1finfo\x1f%s\n' "$1" "$2" "$3" "$4"
}

# Run after rofi has faded out, so it never appears in the picture.
later() {
    setsid -f sh -c "sleep 0.3; $1" >/dev/null 2>&1
}

case "${ROFI_INFO:-}" in
    "")
        printf '\0no-custom\x1ftrue\n'
        printf '\0markup-rows\x1ftrue\n'
        if [[ "$("$scripts/record" status)" == true ]]; then
            row "Stop recording" "and copy the file's path" media-playback-stop-symbolic record:stop
        fi
        row "Region" "drag over an area" transform-crop shot:region
        row "Window" "click a window" window shot:window
        row "This display" "the one you are on" display-symbolic shot:display
        row "All displays" "every screen at once" view-fullscreen shot:all
        row "Record a region" "drag over an area" media-record-symbolic record:region
        row "Record a window" "its area, click a window" media-record-symbolic record:window
        row "Record this display" "the one you are on" media-record-symbolic record:display
        ;;
    shot:*) later "$scripts/screenshot ${ROFI_INFO#shot:}" ;;
    record:*) later "$scripts/record ${ROFI_INFO#record:}" ;;
esac
