configuration {
    /* Sections are passed by ./launcher; this is what plain `rofi -show drun` uses. */
    modes: "drun,window";
    show-icons: true;
    icon-theme: "Reversal-blue-dark";
    terminal: "ghostty";

    /* Matching */
    case-sensitive: false;
    normalize-match: true;
    matching: "normal";
    tokenize: true;
    sort: false;
    cycle: true;

    /* Apps */
    display-drun: "Apps";
    drun-match-fields: "name,generic,exec,categories,keywords";
    drun-display-format: "{name}[  <span alpha='55%'>{generic}</span>]";
    drun-show-actions: false;
    drun-url-launcher: "xdg-open";
    drun {
        parse-user: true;
        parse-system: true;
    }
    run,drun {
        fallback-icon: "application-x-addon";
    }

    /* Windows */
    display-window: "Windows";
    window-match-fields: "title,class";
    window-format: "{c}   {t}";

    /* History */
    disable-history: false;
    max-history-size: 25;

    /* Tab moves between sections; arrows move between rows. */
    kb-mode-next: "Tab,Shift+Right,Control+Tab";
    kb-mode-previous: "ISO_Left_Tab,Shift+Left,Control+ISO_Left_Tab";
    kb-element-next: "";
    kb-element-prev: "";

    click-to-exit: true;
    steal-focus: false;

    filebrowser {
        directories-first: true;
        sorting-method: "name";
    }
    timeout {
        action: "kb-cancel";
        delay: 0;
    }
}

@theme "nocturne"
