# Nocturne terminal: glass. The background lets the blurred desktop through;
# text stays solid. At 85%, body text keeps 12.3:1 over the moon on the
# wallpaper and comments 4.6:1, above the 4.5:1 minimum everywhere.
# Colours live in themes/nocturne, generated by nocturne/build.
theme = nocturne

font-family = Lilex Nerd Font
font-size = 10.5
adjust-cell-height = 15%

background-opacity = 0.85
# Also coloured cells, such as tmux's status line and Neovim's background.
background-opacity-cells = true
# Ask Hyprland to blur what is behind (ext-background-effect-v1).
background-blur = true

# A steady block in the accent colour. zsh switches it to a bar in insert mode.
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

window-width = 106
window-height = 26
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-inherit-working-directory = false

mouse-hide-while-typing = true

# Compact GTK tabs/titlebar.
gtk-toolbar-style = flat
gtk-wide-tabs = false

term = xterm-256color

# Send Ctrl-W for editor-style "delete previous word" behavior.
keybind = ctrl+backspace=text:\x17
keybind = ctrl+enter=unbind
