# Colours: zathura/nocturne, generated by nocturne/build.
include nocturne

# Zoom
map [normal] <C-=> zoom in
map [normal] <C--> zoom out
map [normal] = zoom in
map [normal] - zoom out

# Pages follow the dark theme: window background with body-text ink.
set recolor                     "true"
set recolor-keephue             "false"

# Font and UI
set font "Lilex Nerd Font 10"
set selection-clipboard clipboard

# Quality of life improvements
set scroll-step 50
set adjust-open "width"
set smooth-scroll "true"
set page-padding 8

# Status bar
set statusbar-home-tilde "true"
set window-title-basename "true"
set statusbar-basename "true"
